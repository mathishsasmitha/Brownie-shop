<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title>My Dashboard – Sugar Corner</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root {\r\n            --brown-dark: #2C1810; --brown-mid: #5C3317; --brown-warm: #8B4513;\r\n            --caramel: #C68642; --cream: #FDF6EC; --cream-dark: #F5E6D0;\r\n            --white: #FFFEF9; --text-dark: #1A0F08; --text-muted: #7A5C45;\r\n            --sidebar-w: 260px;\r\n        }\r\n        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n        body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--text-dark); display: flex; min-height: 100vh; }\r\n\r\n        /* ── Sidebar ── */\r\n        .sidebar {\r\n            width: var(--sidebar-w); background: linear-gradient(175deg, var(--brown-dark) 0%, var(--brown-mid) 100%);\r\n            display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh;\r\n            padding: 32px 0; z-index: 100;\r\n            animation: slideIn .5s ease both;\r\n        }\r\n        @keyframes slideIn { from { transform: translateX(-100%); } to { transform: translateX(0); } }\r\n\r\n        .sidebar-brand {\r\n            text-align: center; padding: 0 24px 32px; border-bottom: 1px solid rgba(255,255,255,.1);\r\n        }\r\n        .sidebar-brand .logo { font-size: 38px; display: block; margin-bottom: 8px; }\r\n        .sidebar-brand h2 { font-family: 'Playfair Display', serif; color: var(--cream); font-size: 1.3rem; }\r\n        .sidebar-brand small { color: var(--caramel); font-size: .75rem; letter-spacing: 1px; text-transform: uppercase; }\r\n\r\n        /* User card in sidebar */\r\n        .user-card {\r\n            margin: 24px 16px;\r\n            background: rgba(255,255,255,.07);\r\n            border-radius: 16px;\r\n            padding: 16px;\r\n            display: flex; align-items: center; gap: 12px;\r\n        }\r\n        .user-avatar {\r\n            width: 46px; height: 46px; border-radius: 50%;\r\n            background: linear-gradient(135deg, var(--caramel), var(--brown-warm));\r\n            display: flex; align-items: center; justify-content: center;\r\n            font-size: 18px; font-weight: 600; color: var(--cream); flex-shrink: 0;\r\n            overflow: hidden;\r\n        }\r\n        .user-avatar img { width: 100%; height: 100%; object-fit: cover; }\r\n        .user-name { color: var(--cream); font-size: .9rem; font-weight: 500; }\r\n        .user-email { color: rgba(253,246,236,.6); font-size: .72rem; word-break: break-all; }\r\n\r\n        nav { padding: 8px 16px; flex: 1; }\r\n        .nav-section { font-size: .68rem; letter-spacing: 1.5px; text-transform: uppercase;\r\n            color: rgba(253,246,236,.4); padding: 16px 12px 6px; }\r\n        .nav-item {\r\n            display: flex; align-items: center; gap: 12px;\r\n            padding: 11px 14px; border-radius: 12px; margin-bottom: 4px;\r\n            color: rgba(253,246,236,.8); font-size: .88rem; text-decoration: none;\r\n            transition: all .2s; cursor: pointer;\r\n        }\r\n        .nav-item:hover, .nav-item.active {\r\n            background: rgba(196,134,66,.25); color: var(--cream);\r\n        }\r\n        .nav-item.active { background: linear-gradient(135deg, rgba(196,134,66,.3), rgba(139,69,19,.3)); }\r\n        .nav-icon { font-size: 17px; width: 22px; text-align: center; }\r\n\r\n        .sidebar-footer { padding: 0 16px 16px; }\r\n        .logout-btn {\r\n            display: flex; align-items: center; gap: 10px;\r\n            padding: 11px 14px; border-radius: 12px;\r\n            color: rgba(253,246,236,.6); font-size: .85rem; text-decoration: none;\r\n            border: 1px solid rgba(255,255,255,.1); transition: all .2s;\r\n        }\r\n        .logout-btn:hover { background: rgba(192,57,43,.25); color: #FF8A80; border-color: rgba(192,57,43,.4); }\r\n\r\n        /* ── Main ── */\r\n        .main {\r\n            margin-left: var(--sidebar-w); flex: 1; display: flex; flex-direction: column;\r\n        }\r\n\r\n        .topbar {\r\n            background: var(--white); padding: 20px 36px;\r\n            border-bottom: 1px solid var(--cream-dark);\r\n            display: flex; align-items: center; justify-content: space-between;\r\n            position: sticky; top: 0; z-index: 50;\r\n            box-shadow: 0 2px 12px rgba(44,24,16,.06);\r\n        }\r\n        .topbar h1 { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--brown-dark); }\r\n        .topbar-time { color: var(--text-muted); font-size: .85rem; }\r\n\r\n        .content { padding: 36px; }\r\n\r\n        /* ── Welcome banner ── */\r\n        .welcome-banner {\r\n            background: linear-gradient(135deg, var(--brown-warm) 0%, var(--brown-mid) 100%);\r\n            border-radius: 20px; padding: 36px 40px;\r\n            display: flex; align-items: center; justify-content: space-between;\r\n            margin-bottom: 32px; overflow: hidden; position: relative;\r\n            animation: fadeSlideUp .5s ease both .1s;\r\n        }\r\n        .welcome-banner::after {\r\n            content: '\uD83C\uDF6B'; position: absolute; right: -20px; bottom: -30px;\r\n            font-size: 140px; opacity: .12;\r\n        }\r\n        .welcome-banner h2 { font-family: 'Playfair Display', serif; font-size: 1.9rem; color: var(--cream); }\r\n        .welcome-banner p  { color: rgba(253,246,236,.75); font-size: .9rem; margin-top: 6px; }\r\n        .btn-order {\r\n            padding: 13px 28px; background: var(--caramel);\r\n            color: var(--white); border: none; border-radius: 12px;\r\n            font-family: inherit; font-size: .9rem; font-weight: 600;\r\n            cursor: pointer; text-decoration: none; white-space: nowrap;\r\n            transition: all .2s; flex-shrink: 0;\r\n        }\r\n        .btn-order:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.25); }\r\n\r\n        /* ── Quick stats ── */\r\n        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }\r\n        .stat-card {\r\n            background: var(--white); border-radius: 16px; padding: 24px 24px;\r\n            border: 1px solid var(--cream-dark); position: relative; overflow: hidden;\r\n            transition: transform .2s, box-shadow .2s;\r\n            animation: fadeSlideUp .5s ease both;\r\n        }\r\n        .stat-card:nth-child(1){ animation-delay: .15s; }\r\n        .stat-card:nth-child(2){ animation-delay: .25s; }\r\n        .stat-card:nth-child(3){ animation-delay: .35s; }\r\n        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(44,24,16,.1); }\r\n        .stat-icon {\r\n            width: 52px; height: 52px; border-radius: 14px;\r\n            display: flex; align-items: center; justify-content: center; font-size: 24px;\r\n            margin-bottom: 16px;\r\n        }\r\n        .stat-icon.orange { background: #FFF3E0; }\r\n        .stat-icon.green  { background: #E8F5E9; }\r\n        .stat-icon.blue   { background: #E3F2FD; }\r\n        .stat-num  { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--brown-dark); }\r\n        .stat-label{ color: var(--text-muted); font-size: .82rem; margin-top: 4px; }\r\n\r\n        /* ── Sections ── */\r\n        .section-title {\r\n            font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--brown-dark);\r\n            margin-bottom: 20px;\r\n        }\r\n        .quick-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 32px; }\r\n        .action-card {\r\n            background: var(--white); border-radius: 16px; padding: 24px;\r\n            border: 1px solid var(--cream-dark); text-decoration: none;\r\n            display: flex; align-items: center; gap: 16px;\r\n            transition: all .2s;\r\n            animation: fadeSlideUp .5s ease both .3s;\r\n        }\r\n        .action-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(44,24,16,.1); border-color: var(--caramel); }\r\n        .action-emoji { font-size: 32px; }\r\n        .action-title { font-weight: 600; color: var(--brown-dark); font-size: .95rem; }\r\n        .action-sub   { color: var(--text-muted); font-size: .8rem; margin-top: 2px; }\r\n\r\n        @keyframes fadeSlideUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }\r\n\r\n        @media (max-width: 900px) {\r\n            .sidebar { display: none; }\r\n            .main { margin-left: 0; }\r\n            .stats-grid { grid-template-columns: 1fr 1fr; }\r\n        }\r\n        @media (max-width: 580px) {\r\n            .stats-grid { grid-template-columns: 1fr; }\r\n            .quick-actions { grid-template-columns: 1fr; }\r\n            .content { padding: 20px; }\r\n            .welcome-banner { flex-direction: column; gap: 20px; text-align: center; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- SIDEBAR -->\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <small>Customer Portal</small>\r\n    </div>\r\n\r\n    <div class=\"user-card\">\r\n        <div class=\"user-avatar\">\r\n            <img th:if=\"${customer.profilePhotoPath}\" th:src=\"'/' + ${customer.profilePhotoPath}\" alt=\"photo\"/>\r\n            <span th:unless=\"${customer.profilePhotoPath}\" th:text=\"${customer.firstName?.substring(0,1)?.toUpperCase()}\">K</span>\r\n        </div>\r\n        <div>\r\n            <div class=\"user-name\" th:text=\"${customer.firstName + ' ' + customer.lastName}\">Kasun Perera</div>\r\n            <div class=\"user-email\" th:text=\"${customer.email}\">kasun@example.com</div>\r\n        </div>\r\n    </div>\r\n\r\n    <nav>\r\n        <div class=\"nav-section\">Main Menu</div>\r\n        <a class=\"nav-item active\" href=\"/customer/dashboard\">\r\n            <span class=\"nav-icon\">\uD83C\uDFE0</span> Dashboard\r\n        </a>\r\n        <a class=\"nav-item\" href=\"/customer/profile\">\r\n            <span class=\"nav-icon\">\uD83D\uDC64</span> My Profile\r\n        </a>\r\n\r\n        <div class=\"nav-section\">Shop</div>\r\n        <a class=\"nav-item\" href=\"/products\">\r\n            <span class=\"nav-icon\">\uD83C\uDF6B</span> Browse Brownies\r\n        </a>\r\n        <a class=\"nav-item\" href=\"#\">\r\n            <span class=\"nav-icon\">\uD83D\uDCE6</span> My Orders\r\n        </a>\r\n\r\n        <div class=\"nav-section\">Support</div>\r\n        <a class=\"nav-item\" href=\"#\">\r\n            <span class=\"nav-icon\">\uD83D\uDCAC</span> Contact Us\r\n        </a>\r\n        <a class=\"nav-item\" href=\"#\">\r\n            <span class=\"nav-icon\">⭐</span> My Feedback\r\n        </a>\r\n    </nav>\r\n\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" href=\"/logout\">\r\n            <span>\uD83D\uDEAA</span> Sign Out\r\n        </a>\r\n    </div>\r\n</aside>\r\n\r\n<!-- MAIN CONTENT -->\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <h1>Dashboard</h1>\r\n        <span class=\"topbar-time\" id=\"clock\">–</span>\r\n    </div>\r\n\r\n    <div class=\"content\">\r\n\r\n        <!-- Welcome Banner -->\r\n        <div class=\"welcome-banner\">\r\n            <div>\r\n                <h2>Hello, <span th:text=\"${customer.firstName}\">Kasun</span>! \uD83D\uDC4B</h2>\r\n                <p>Welcome back to Sugar Corner. Ready for something sweet today?</p>\r\n            </div>\r\n            <a href=\"/products\" class=\"btn-order\">\uD83D\uDED2 Order Now</a>\r\n        </div>\r\n\r\n        <!-- Stats -->\r\n        <div class=\"stats-grid\">\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-icon orange\">\uD83D\uDCE6</div>\r\n                <div class=\"stat-num\">0</div>\r\n                <div class=\"stat-label\">Total Orders</div>\r\n            </div>\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-icon green\">✅</div>\r\n                <div class=\"stat-num\">0</div>\r\n                <div class=\"stat-label\">Delivered</div>\r\n            </div>\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-icon blue\">\uD83D\uDE9A</div>\r\n                <div class=\"stat-num\">0</div>\r\n                <div class=\"stat-label\">In Progress</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Quick Actions -->\r\n        <div class=\"section-title\">Quick Actions</div>\r\n        <div class=\"quick-actions\">\r\n            <a class=\"action-card\" href=\"/customer/profile\">\r\n                <span class=\"action-emoji\">\uD83D\uDC64</span>\r\n                <div>\r\n                    <div class=\"action-title\">Update Profile</div>\r\n                    <div class=\"action-sub\">Edit your personal information</div>\r\n                </div>\r\n            </a>\r\n            <a class=\"action-card\" href=\"/products\">\r\n                <span class=\"action-emoji\">\uD83C\uDF6B</span>\r\n                <div>\r\n                    <div class=\"action-title\">Browse Brownies</div>\r\n                    <div class=\"action-sub\">See all available products</div>\r\n                </div>\r\n            </a>\r\n            <a class=\"action-card\" href=\"#\">\r\n                <span class=\"action-emoji\">\uD83D\uDCCB</span>\r\n                <div>\r\n                    <div class=\"action-title\">View Orders</div>\r\n                    <div class=\"action-sub\">Check order history & status</div>\r\n                </div>\r\n            </a>\r\n            <a class=\"action-card\" href=\"#\">\r\n                <span class=\"action-emoji\">\uD83D\uDCAC</span>\r\n                <div>\r\n                    <div class=\"action-title\">Send Inquiry</div>\r\n                    <div class=\"action-sub\">Get help from our team</div>\r\n                </div>\r\n            </a>\r\n        </div>\r\n\r\n    </div><!-- /content -->\r\n</div><!-- /main -->\r\n\r\n<script>\r\n    function updateClock() {\r\n        const el = document.getElementById('clock');\r\n        el.textContent = new Date().toLocaleString('en-LK', {\r\n            weekday:'short', year:'numeric', month:'short', day:'numeric',\r\n            hour:'2-digit', minute:'2-digit'\r\n        });\r\n    }\r\n    updateClock();\r\n    setInterval(updateClock, 1000);\r\n</script>\r\n</body>\r\n</html>
