<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title>My Profile – Sugar Corner</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root {\r\n            --brown-dark: #2C1810; --brown-mid: #5C3317; --brown-warm: #8B4513;\r\n            --caramel: #C68642; --cream: #FDF6EC; --cream-dark: #F5E6D0;\r\n            --white: #FFFEF9; --text-dark: #1A0F08; --text-muted: #7A5C45;\r\n            --sidebar-w: 260px; --success: #27AE60; --error: #C0392B;\r\n        }\r\n        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n        body { font-family: 'DM Sans', sans-serif; background: var(--cream); display: flex; min-height: 100vh; }\r\n\r\n        /* ── Sidebar (same as dashboard) ── */\r\n        .sidebar {\r\n            width: var(--sidebar-w); background: linear-gradient(175deg, var(--brown-dark), var(--brown-mid));\r\n            position: fixed; top: 0; left: 0; height: 100vh;\r\n            display: flex; flex-direction: column; padding: 32px 0; z-index: 100;\r\n        }\r\n        .sidebar-brand { text-align:center; padding:0 24px 32px; border-bottom:1px solid rgba(255,255,255,.1); }\r\n        .sidebar-brand .logo { font-size:38px; display:block; margin-bottom:8px; }\r\n        .sidebar-brand h2 { font-family:'Playfair Display',serif; color:var(--cream); font-size:1.3rem; }\r\n        .sidebar-brand small { color:var(--caramel); font-size:.75rem; letter-spacing:1px; text-transform:uppercase; }\r\n        .user-card { margin:24px 16px; background:rgba(255,255,255,.07); border-radius:16px; padding:16px;\r\n            display:flex; align-items:center; gap:12px; }\r\n        .user-avatar { width:46px; height:46px; border-radius:50%;\r\n            background:linear-gradient(135deg, var(--caramel), var(--brown-warm));\r\n            display:flex; align-items:center; justify-content:center;\r\n            font-size:18px; font-weight:600; color:var(--cream); flex-shrink:0; overflow:hidden; }\r\n        .user-avatar img { width:100%; height:100%; object-fit:cover; }\r\n        .user-name  { color:var(--cream); font-size:.9rem; font-weight:500; }\r\n        .user-email { color:rgba(253,246,236,.6); font-size:.72rem; word-break:break-all; }\r\n        nav { padding:8px 16px; flex:1; }\r\n        .nav-section { font-size:.68rem; letter-spacing:1.5px; text-transform:uppercase; color:rgba(253,246,236,.4); padding:16px 12px 6px; }\r\n        .nav-item { display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:12px; margin-bottom:4px;\r\n            color:rgba(253,246,236,.8); font-size:.88rem; text-decoration:none; transition:all .2s; }\r\n        .nav-item:hover,.nav-item.active { background:rgba(196,134,66,.25); color:var(--cream); }\r\n        .nav-icon { font-size:17px; width:22px; text-align:center; }\r\n        .sidebar-footer { padding:0 16px 16px; }\r\n        .logout-btn { display:flex; align-items:center; gap:10px; padding:11px 14px; border-radius:12px;\r\n            color:rgba(253,246,236,.6); font-size:.85rem; text-decoration:none; border:1px solid rgba(255,255,255,.1); transition:all .2s; }\r\n        .logout-btn:hover { background:rgba(192,57,43,.25); color:#FF8A80; }\r\n\r\n        /* ── Main ── */\r\n        .main { margin-left:var(--sidebar-w); flex:1; }\r\n        .topbar {\r\n            background:var(--white); padding:20px 36px;\r\n            border-bottom:1px solid var(--cream-dark);\r\n            display:flex; align-items:center; gap:12px;\r\n            position:sticky; top:0; z-index:50;\r\n            box-shadow:0 2px 12px rgba(44,24,16,.06);\r\n        }\r\n        .topbar a { color:var(--text-muted); font-size:.85rem; text-decoration:none; }\r\n        .topbar a:hover { color:var(--brown-warm); }\r\n        .topbar .sep { color:var(--text-muted); }\r\n        .topbar h1 { font-family:'Playfair Display',serif; font-size:1.5rem; color:var(--brown-dark); }\r\n\r\n        .content { padding:36px; max-width:900px; }\r\n\r\n        .alert { padding:13px 18px; border-radius:12px; font-size:.875rem; margin-bottom:24px;\r\n            display:flex; align-items:center; gap:8px;\r\n            animation: fadeSlideUp .4s ease; }\r\n        .alert-success { background:#EFD; border-left:4px solid var(--success); color:var(--success); }\r\n        .alert-error   { background:#FEE; border-left:4px solid var(--error);   color:var(--error); }\r\n\r\n        /* ── Profile Photo Card ── */\r\n        .photo-card {\r\n            background:var(--white); border-radius:20px; padding:32px;\r\n            border:1px solid var(--cream-dark); margin-bottom:24px;\r\n            display:flex; align-items:center; gap:28px;\r\n            animation: fadeSlideUp .5s ease both;\r\n        }\r\n        .photo-preview {\r\n            width:100px; height:100px; border-radius:50%;\r\n            background:linear-gradient(135deg, var(--caramel), var(--brown-warm));\r\n            display:flex; align-items:center; justify-content:center;\r\n            font-size:38px; font-weight:700; color:var(--cream);\r\n            flex-shrink:0; overflow:hidden; border:4px solid var(--cream-dark);\r\n            transition: border-color .2s;\r\n        }\r\n        .photo-preview:hover { border-color:var(--caramel); }\r\n        .photo-preview img { width:100%; height:100%; object-fit:cover; }\r\n        .photo-info h3 { font-family:'Playfair Display',serif; font-size:1.3rem; color:var(--brown-dark); }\r\n        .photo-info p  { color:var(--text-muted); font-size:.83rem; margin-top:4px; }\r\n        .photo-actions { display:flex; gap:10px; margin-top:14px; }\r\n        .btn-upload {\r\n            padding:9px 20px; background:var(--brown-warm); color:var(--cream);\r\n            border:none; border-radius:10px; font-family:inherit; font-size:.85rem;\r\n            cursor:pointer; transition:all .2s;\r\n        }\r\n        .btn-upload:hover { background:var(--brown-mid); transform:translateY(-1px); }\r\n        #photoInput { display:none; }\r\n\r\n        /* ── Form Card ── */\r\n        .form-card {\r\n            background:var(--white); border-radius:20px; padding:32px 36px;\r\n            border:1px solid var(--cream-dark);\r\n            animation:fadeSlideUp .5s ease both .1s;\r\n        }\r\n        .form-section-title {\r\n            font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--brown-dark);\r\n            margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid var(--cream-dark);\r\n            display:flex; align-items:center; gap:8px;\r\n        }\r\n\r\n        .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px 24px; margin-bottom:28px; }\r\n        .form-full { grid-column:1/-1; }\r\n\r\n        .form-group { display:flex; flex-direction:column; gap:7px; }\r\n        label { font-size:.75rem; font-weight:500; letter-spacing:.5px; text-transform:uppercase; color:var(--text-dark); }\r\n        .input-wrap { position:relative; }\r\n        .input-wrap .icon { position:absolute; left:13px; top:50%; transform:translateY(-50%); font-size:15px; color:var(--caramel); pointer-events:none; }\r\n\r\n        input[type=text], input[type=email], input[type=tel], input[type=date] {\r\n            width:100%; padding:11px 12px 11px 40px;\r\n            border:1.5px solid #E8D8C4; border-radius:11px;\r\n            font-family:inherit; font-size:.88rem; color:var(--text-dark);\r\n            background:var(--cream); outline:none; transition:all .2s;\r\n        }\r\n        input:focus { border-color:var(--caramel); background:var(--white); box-shadow:0 0 0 3px rgba(196,134,66,.12); }\r\n        input[readonly] { background:#F5F5F5; color:var(--text-muted); cursor:not-allowed; }\r\n\r\n        .form-actions { display:flex; gap:14px; padding-top:20px; border-top:1px solid var(--cream-dark); }\r\n        .btn-primary {\r\n            padding:12px 32px; background:linear-gradient(135deg, var(--brown-warm), var(--brown-mid));\r\n            color:var(--cream); border:none; border-radius:11px;\r\n            font-family:inherit; font-size:.9rem; font-weight:500; cursor:pointer; transition:all .2s;\r\n        }\r\n        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(92,51,23,.3); }\r\n        .btn-secondary {\r\n            padding:12px 24px; background:transparent;\r\n            color:var(--text-muted); border:1.5px solid #E8D8C4; border-radius:11px;\r\n            font-family:inherit; font-size:.9rem; cursor:pointer; transition:all .2s; text-decoration:none; display:flex; align-items:center;\r\n        }\r\n        .btn-secondary:hover { border-color:var(--caramel); color:var(--brown-warm); }\r\n\r\n        @keyframes fadeSlideUp { from{opacity:0;transform:translateY(16px);} to{opacity:1;transform:translateY(0);} }\r\n\r\n        @media (max-width:900px) { .sidebar{display:none;} .main{margin-left:0;} }\r\n        @media (max-width:600px) { .form-grid{grid-template-columns:1fr;} .content{padding:20px;} .photo-card{flex-direction:column;text-align:center;} }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- SIDEBAR -->\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <small>Customer Portal</small>\r\n    </div>\r\n    <div class=\"user-card\">\r\n        <div class=\"user-avatar\">\r\n            <img th:if=\"${customer.profilePhotoPath}\" th:src=\"'/' + ${customer.profilePhotoPath}\" alt=\"photo\"/>\r\n            <span th:unless=\"${customer.profilePhotoPath}\" th:text=\"${customer.firstName?.substring(0,1)?.toUpperCase()}\">K</span>\r\n        </div>\r\n        <div>\r\n            <div class=\"user-name\" th:text=\"${customer.firstName + ' ' + customer.lastName}\">Kasun Perera</div>\r\n            <div class=\"user-email\" th:text=\"${customer.email}\">kasun@example.com</div>\r\n        </div>\r\n    </div>\r\n    <nav>\r\n        <div class=\"nav-section\">Main Menu</div>\r\n        <a class=\"nav-item\" href=\"/customer/dashboard\"><span class=\"nav-icon\">\uD83C\uDFE0</span> Dashboard</a>\r\n        <a class=\"nav-item active\" href=\"/customer/profile\"><span class=\"nav-icon\">\uD83D\uDC64</span> My Profile</a>\r\n        <div class=\"nav-section\">Orders</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCE6</span> My Orders</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDED2</span> Shop Brownies</a>\r\n        <div class=\"nav-section\">Support</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCAC</span> Contact Us</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">⭐</span> My Feedback</a>\r\n    </nav>\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" href=\"/logout\"><span>\uD83D\uDEAA</span> Sign Out</a>\r\n    </div>\r\n</aside>\r\n\r\n<!-- MAIN -->\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <a href=\"/customer/dashboard\">Dashboard</a>\r\n        <span class=\"sep\">›</span>\r\n        <h1>My Profile</h1>\r\n    </div>\r\n\r\n    <div class=\"content\">\r\n\r\n        <div th:if=\"${success}\" class=\"alert alert-success\">✅ <span th:text=\"${success}\"></span></div>\r\n        <div th:if=\"${error}\"   class=\"alert alert-error\">⚠\uFE0F <span th:text=\"${error}\"></span></div>\r\n\r\n        <!-- Photo Card -->\r\n        <div class=\"photo-card\">\r\n            <div class=\"photo-preview\" id=\"photoPreview\">\r\n                <img th:if=\"${customer.profilePhotoPath}\" th:src=\"'/' + ${customer.profilePhotoPath}\" alt=\"photo\" id=\"photoImg\"/>\r\n                <span th:unless=\"${customer.profilePhotoPath}\" th:text=\"${customer.firstName?.substring(0,1)?.toUpperCase()}\" id=\"photoInitial\">K</span>\r\n            </div>\r\n            <div class=\"photo-info\">\r\n                <h3 th:text=\"${customer.firstName + ' ' + customer.lastName}\">Kasun Perera</h3>\r\n                <p>Member since <span th:text=\"${#temporals.format(customer.createdAt, 'MMMM yyyy')}\">January 2025</span></p>\r\n                <p style=\"margin-top:4px;\" th:text=\"${customer.email}\">kasun@example.com</p>\r\n                <div class=\"photo-actions\">\r\n                    <form method=\"POST\" action=\"/customer/profile/photo\" enctype=\"multipart/form-data\" id=\"photoForm\">\r\n                        <input type=\"file\" id=\"photoInput\" name=\"photo\" accept=\"image/*\" onchange=\"previewPhoto(event)\"/>\r\n                        <button type=\"button\" class=\"btn-upload\" onclick=\"document.getElementById('photoInput').click()\">\uD83D\uDCF7 Change Photo</button>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Profile Form -->\r\n        <div class=\"form-card\">\r\n            <form method=\"POST\" action=\"/customer/profile/update\">\r\n\r\n                <div class=\"form-section-title\">\uD83D\uDC64 Personal Information</div>\r\n                <div class=\"form-grid\">\r\n                    <div class=\"form-group\">\r\n                        <label>First Name</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83D\uDC64</span>\r\n                            <input type=\"text\" name=\"firstName\" th:value=\"${customer.firstName}\" required/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Last Name</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83D\uDC64</span>\r\n                            <input type=\"text\" name=\"lastName\" th:value=\"${customer.lastName}\" required/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Email Address</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">✉\uFE0F</span>\r\n                            <input type=\"email\" th:value=\"${customer.email}\" readonly/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Phone Number</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83D\uDCF1</span>\r\n                            <input type=\"tel\" name=\"phone\" th:value=\"${customer.phone}\" placeholder=\"0771234567\"/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Date of Birth</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83C\uDF82</span>\r\n                            <input type=\"date\" name=\"dateOfBirth\" th:value=\"${customer.dateOfBirth}\"/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"form-section-title\">\uD83D\uDCCD Address</div>\r\n                <div class=\"form-grid\">\r\n                    <div class=\"form-group form-full\">\r\n                        <label>Address Line 1</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83C\uDFE0</span>\r\n                            <input type=\"text\" name=\"addressLine1\" th:value=\"${customer.addressLine1}\" placeholder=\"No. 12, Galle Road\"/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group form-full\">\r\n                        <label>Address Line 2 <small style=\"text-transform:none;font-weight:300;\">(optional)</small></label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83C\uDFE0</span>\r\n                            <input type=\"text\" name=\"addressLine2\" th:value=\"${customer.addressLine2}\" placeholder=\"Apartment, suite, etc.\"/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>City</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83C\uDF06</span>\r\n                            <input type=\"text\" name=\"city\" th:value=\"${customer.city}\" placeholder=\"Colombo\"/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Postal Code</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83D\uDCEE</span>\r\n                            <input type=\"text\" name=\"postalCode\" th:value=\"${customer.postalCode}\" placeholder=\"00300\"/>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Country</label>\r\n                        <div class=\"input-wrap\">\r\n                            <span class=\"icon\">\uD83C\uDF0D</span>\r\n                            <input type=\"text\" name=\"country\" th:value=\"${customer.country}\" placeholder=\"Sri Lanka\"/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"form-actions\">\r\n                    <button type=\"submit\" class=\"btn-primary\">\uD83D\uDCBE Save Changes</button>\r\n                    <a href=\"/customer/dashboard\" class=\"btn-secondary\">Cancel</a>\r\n                </div>\r\n\r\n            </form>\r\n        </div>\r\n\r\n    </div><!-- /content -->\r\n</div><!-- /main -->\r\n\r\n<script>\r\n    function previewPhoto(event) {\r\n        const file = event.target.files[0];\r\n        if (!file) return;\r\n        const reader = new FileReader();\r\n        reader.onload = e => {\r\n            const preview = document.getElementById('photoPreview');\r\n            // Remove initial text\r\n            const initial = document.getElementById('photoInitial');\r\n            if (initial) initial.style.display = 'none';\r\n            // Set or update img\r\n            let img = document.getElementById('photoImg');\r\n            if (!img) {\r\n                img = document.createElement('img');\r\n                img.id = 'photoImg';\r\n                preview.appendChild(img);\r\n            }\r\n            img.src = e.target.result;\r\n            img.style.display = 'block';\r\n            // Auto-submit photo form\r\n            document.getElementById('photoForm').submit();\r\n        };\r\n        reader.readAsDataURL(file);\r\n    }\r\n</script>\r\n</body>\r\n</html>
