<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title>Checkout – Sugar Corner</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root{--brown-dark:#2C1810;--brown-mid:#5C3317;--brown-warm:#8B4513;--caramel:#C68642;\r\n            --cream:#FDF6EC;--cream-dark:#F5E6D0;--white:#FFFEF9;--text-dark:#1A0F08;\r\n            --text-muted:#7A5C45;--success:#27AE60;--error:#C0392B;--sidebar-w:260px;}\r\n        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}\r\n        body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--text-dark);display:flex;min-height:100vh;}\r\n        .sidebar{width:var(--sidebar-w);background:linear-gradient(175deg,var(--brown-dark),var(--brown-mid));\r\n            position:fixed;top:0;left:0;height:100vh;display:flex;flex-direction:column;padding:32px 0;z-index:100;}\r\n        .sidebar-brand{text-align:center;padding:0 24px 32px;border-bottom:1px solid rgba(255,255,255,.1);}\r\n        .sidebar-brand .logo{font-size:38px;display:block;margin-bottom:8px;}\r\n        .sidebar-brand h2{font-family:'Playfair Display',serif;color:var(--cream);font-size:1.3rem;}\r\n        .sidebar-brand small{color:var(--caramel);font-size:.75rem;letter-spacing:1px;text-transform:uppercase;}\r\n        nav{flex:1;padding:8px 16px;}\r\n        .nav-section{font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(253,246,236,.4);padding:14px 12px 5px;}\r\n        .nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:12px;margin-bottom:3px;\r\n            color:rgba(253,246,236,.8);font-size:.87rem;text-decoration:none;transition:all .2s;}\r\n        .nav-item:hover,.nav-item.active{background:rgba(196,134,66,.25);color:var(--cream);}\r\n        .nav-icon{font-size:16px;width:20px;text-align:center;}\r\n        .sidebar-footer{padding:0 16px 16px;}\r\n        .logout-btn{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;\r\n            color:rgba(253,246,236,.6);font-size:.85rem;text-decoration:none;border:1px solid rgba(255,255,255,.1);transition:all .2s;}\r\n        .logout-btn:hover{background:rgba(192,57,43,.25);color:#FF8A80;border-color:rgba(192,57,43,.4);}\r\n        .main{margin-left:var(--sidebar-w);flex:1;}\r\n        .topbar{background:var(--white);padding:18px 36px;border-bottom:1px solid var(--cream-dark);\r\n            display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:50;box-shadow:0 2px 12px rgba(44,24,16,.06);}\r\n        .topbar a{color:var(--text-muted);font-size:.84rem;text-decoration:none;}\r\n        .topbar a:hover{color:var(--brown-warm);}\r\n        .topbar .sep{color:var(--text-muted);}\r\n        .topbar h1{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--brown-dark);}\r\n        .content{padding:32px 36px;max-width:960px;}\r\n        .checkout-grid{display:grid;grid-template-columns:1fr 380px;gap:24px;align-items:start;}\r\n\r\n        /* Order summary card */\r\n        .summary-card{background:var(--white);border-radius:20px;border:1px solid var(--cream-dark);\r\n            overflow:hidden;position:sticky;top:90px;animation:fadeSlideUp .4s ease both;}\r\n        .summary-header{background:linear-gradient(135deg,var(--brown-warm),var(--brown-mid));padding:20px 24px;}\r\n        .summary-header h3{font-family:'Playfair Display',serif;color:var(--cream);font-size:1.1rem;}\r\n        .summary-body{padding:20px 24px;}\r\n        .product-row{display:flex;align-items:center;gap:14px;margin-bottom:16px;\r\n            padding-bottom:16px;border-bottom:1px solid var(--cream-dark);}\r\n        .product-thumb{width:56px;height:56px;border-radius:12px;\r\n            background:linear-gradient(135deg,var(--cream-dark),#e8d0b0);\r\n            display:flex;align-items:center;justify-content:center;font-size:24px;overflow:hidden;flex-shrink:0;}\r\n        .product-thumb img{width:100%;height:100%;object-fit:cover;}\r\n        .product-info-name{font-weight:600;color:var(--brown-dark);font-size:.9rem;}\r\n        .product-info-cat{color:var(--text-muted);font-size:.78rem;margin-top:2px;}\r\n        .qty-control{display:flex;align-items:center;gap:10px;margin-top:8px;}\r\n        .qty-btn{width:28px;height:28px;border-radius:8px;border:1.5px solid var(--cream-dark);\r\n            background:var(--cream);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;\r\n            transition:all .2s;}\r\n        .qty-btn:hover{border-color:var(--caramel);background:var(--caramel);color:white;}\r\n        .qty-display{font-weight:600;color:var(--brown-dark);min-width:24px;text-align:center;}\r\n        #qtyInput{display:none;}\r\n        .price-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:.9rem;}\r\n        .price-row.total{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--brown-dark);\r\n            font-weight:700;border-top:1px solid var(--cream-dark);padding-top:12px;margin-top:4px;}\r\n        .price-val{color:var(--caramel);font-weight:600;}\r\n\r\n        /* Form card */\r\n        .form-card{background:var(--white);border-radius:20px;border:1px solid var(--cream-dark);\r\n            padding:28px 32px;animation:fadeSlideUp .4s ease both .1s;}\r\n        .form-section{font-family:'Playfair Display',serif;font-size:1rem;color:var(--brown-dark);\r\n            margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--cream-dark);}\r\n        .form-group{margin-bottom:16px;}\r\n        .form-group label{display:block;font-size:.75rem;font-weight:500;letter-spacing:.5px;\r\n            text-transform:uppercase;color:var(--text-dark);margin-bottom:7px;}\r\n        .form-group input,.form-group textarea,.form-group select{\r\n            width:100%;padding:11px 14px;border:1.5px solid #E8D8C4;border-radius:11px;\r\n            font-family:inherit;font-size:.875rem;color:var(--text-dark);background:var(--cream);outline:none;transition:all .2s;}\r\n        .form-group input:focus,.form-group textarea:focus,.form-group select:focus{\r\n            border-color:var(--caramel);background:var(--white);box-shadow:0 0 0 3px rgba(196,134,66,.1);}\r\n        .form-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}\r\n\r\n        /* Delivery toggle */\r\n        .delivery-toggle{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px;}\r\n        .delivery-option{position:relative;}\r\n        .delivery-option input{position:absolute;opacity:0;width:0;height:0;}\r\n        .delivery-label{display:flex;align-items:center;gap:10px;padding:14px 16px;\r\n            border:1.5px solid #E8D8C4;border-radius:12px;cursor:pointer;transition:all .2s;background:var(--cream);}\r\n        .delivery-option input:checked + .delivery-label{border-color:var(--caramel);\r\n            background:rgba(196,134,66,.08);box-shadow:0 0 0 3px rgba(196,134,66,.1);}\r\n        .delivery-icon{font-size:22px;}\r\n        .delivery-text{font-size:.875rem;font-weight:500;color:var(--brown-dark);}\r\n        .delivery-sub{font-size:.75rem;color:var(--text-muted);}\r\n\r\n        .btn-place{width:100%;padding:15px;background:linear-gradient(135deg,var(--brown-warm),var(--brown-mid));\r\n            color:var(--cream);border:none;border-radius:12px;font-family:inherit;font-size:1rem;font-weight:600;\r\n            cursor:pointer;transition:all .25s;margin-top:20px;}\r\n        .btn-place:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(92,51,23,.3);}\r\n\r\n        @keyframes fadeSlideUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}\r\n        @media(max-width:900px){.sidebar{display:none;}.main{margin-left:0;}}\r\n        @media(max-width:720px){.checkout-grid{grid-template-columns:1fr;}.content{padding:20px;}}\r\n    </style>\r\n</head>\r\n<body>\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <small>Customer Portal</small>\r\n    </div>\r\n    <nav>\r\n        <div class=\"nav-section\">Main Menu</div>\r\n        <a class=\"nav-item\" href=\"/customer/dashboard\"><span class=\"nav-icon\">\uD83C\uDFE0</span> Dashboard</a>\r\n        <a class=\"nav-item\" href=\"/customer/profile\"><span class=\"nav-icon\">\uD83D\uDC64</span> My Profile</a>\r\n        <div class=\"nav-section\">Shop</div>\r\n        <a class=\"nav-item\" href=\"/products\"><span class=\"nav-icon\">\uD83C\uDF6B</span> Browse Brownies</a>\r\n        <a class=\"nav-item active\" href=\"/orders\"><span class=\"nav-icon\">\uD83D\uDCE6</span> My Orders</a>\r\n        <div class=\"nav-section\">Support</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCAC</span> Contact Us</a>\r\n    </nav>\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" href=\"/logout\"><span>\uD83D\uDEAA</span> Sign Out</a>\r\n    </div>\r\n</aside>\r\n\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <a href=\"/products\">Brownies</a>\r\n        <span class=\"sep\">›</span>\r\n        <a th:href=\"'/products/' + ${product.id}\" th:text=\"${product.name}\">Product</a>\r\n        <span class=\"sep\">›</span>\r\n        <h1>Checkout</h1>\r\n    </div>\r\n    <div class=\"content\">\r\n        <div class=\"checkout-grid\">\r\n\r\n            <!-- LEFT: form -->\r\n            <div class=\"form-card\">\r\n                <form method=\"POST\" action=\"/orders/place\" id=\"checkoutForm\">\r\n                    <input type=\"hidden\" name=\"productId\" th:value=\"${product.id}\"/>\r\n                    <input type=\"hidden\" name=\"quantity\" id=\"qtyInput\" th:value=\"${qty}\"/>\r\n\r\n                    <div class=\"form-section\">\uD83D\uDE9A Delivery Method</div>\r\n                    <div class=\"delivery-toggle\">\r\n                        <div class=\"delivery-option\">\r\n                            <input type=\"radio\" name=\"deliveryType\" id=\"delivery\" value=\"DELIVERY\" checked/>\r\n                            <label class=\"delivery-label\" for=\"delivery\">\r\n                                <span class=\"delivery-icon\">\uD83D\uDE9A</span>\r\n                                <div><div class=\"delivery-text\">Delivery</div><div class=\"delivery-sub\">To your address</div></div>\r\n                            </label>\r\n                        </div>\r\n                        <div class=\"delivery-option\">\r\n                            <input type=\"radio\" name=\"deliveryType\" id=\"pickup\" value=\"PICKUP\"/>\r\n                            <label class=\"delivery-label\" for=\"pickup\">\r\n                                <span class=\"delivery-icon\">\uD83C\uDFEA</span>\r\n                                <div><div class=\"delivery-text\">Pickup</div><div class=\"delivery-sub\">Collect from shop</div></div>\r\n                            </label>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div id=\"addressSection\">\r\n                        <div class=\"form-section\">\uD83D\uDCCD Delivery Address</div>\r\n                        <div class=\"form-group\">\r\n                            <label>Street Address</label>\r\n                            <input type=\"text\" name=\"deliveryAddress\"\r\n                                   th:value=\"${customer.addressLine1 != null} ? ${customer.addressLine1} : ''\"\r\n                                   placeholder=\"No. 12, Galle Road\"/>\r\n                        </div>\r\n                        <div class=\"form-grid-2\">\r\n                            <div class=\"form-group\">\r\n                                <label>City</label>\r\n                                <input type=\"text\" name=\"deliveryCity\"\r\n                                       th:value=\"${customer.city != null} ? ${customer.city} : ''\"\r\n                                       placeholder=\"Colombo\"/>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label>Postal Code</label>\r\n                                <input type=\"text\" name=\"deliveryPostalCode\"\r\n                                       th:value=\"${customer.postalCode != null} ? ${customer.postalCode} : ''\"\r\n                                       placeholder=\"00300\"/>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"form-section\">\uD83D\uDCDD Special Requests</div>\r\n                    <div class=\"form-group\">\r\n                        <label>Customization (for this item)</label>\r\n                        <input type=\"text\" name=\"customization\" placeholder=\"e.g. No nuts, extra frosting\"/>\r\n                    </div>\r\n                    <div class=\"form-group\">\r\n                        <label>Order Note (for the shop)</label>\r\n                        <textarea name=\"customerNote\" rows=\"3\"\r\n                                  placeholder=\"Any other instructions for your order…\"></textarea>\r\n                    </div>\r\n\r\n                    <button type=\"submit\" class=\"btn-place\">\uD83D\uDED2 Place Order →</button>\r\n                </form>\r\n            </div>\r\n\r\n            <!-- RIGHT: summary -->\r\n            <div class=\"summary-card\">\r\n                <div class=\"summary-header\"><h3>Order Summary</h3></div>\r\n                <div class=\"summary-body\">\r\n                    <div class=\"product-row\">\r\n                        <div class=\"product-thumb\">\r\n                            <img th:if=\"${product.imagePath != null}\" th:src=\"'/' + ${product.imagePath}\" th:alt=\"${product.name}\"/>\r\n                            <span th:unless=\"${product.imagePath != null}\">\uD83C\uDF6B</span>\r\n                        </div>\r\n                        <div>\r\n                            <div class=\"product-info-name\" th:text=\"${product.name}\">Brownie</div>\r\n                            <div class=\"product-info-cat\" th:text=\"${product.category}\">Classic</div>\r\n                            <div class=\"qty-control\">\r\n                                <button type=\"button\" class=\"qty-btn\" onclick=\"changeQty(-1)\">−</button>\r\n                                <span class=\"qty-display\" id=\"qtyShow\" th:text=\"${qty}\">1</span>\r\n                                <button type=\"button\" class=\"qty-btn\" onclick=\"changeQty(1)\">+</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"price-row\">\r\n                        <span>Unit price</span>\r\n                        <span class=\"price-val\"\r\n                              th:text=\"'Rs. ' + ${#numbers.formatDecimal(product.price,1,'COMMA',2,'POINT')}\">Rs. 0.00</span>\r\n                    </div>\r\n                    <div class=\"price-row\">\r\n                        <span>Quantity</span>\r\n                        <span id=\"qtyLabel\" th:text=\"${qty}\">1</span>\r\n                    </div>\r\n                    <div class=\"price-row total\">\r\n                        <span>Total</span>\r\n                        <span class=\"price-val\" id=\"totalDisplay\">Rs. 0.00</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script th:inline=\"javascript\">\r\n    const unitPrice = /*[[${product.price}]]*/ 0;\r\n    let qty = /*[[${qty}]]*/ 1;\r\n\r\n    function updateDisplay() {\r\n        document.getElementById('qtyShow').textContent = qty;\r\n        document.getElementById('qtyLabel').textContent = qty;\r\n        document.getElementById('qtyInput').value = qty;\r\n        const total = (unitPrice * qty).toFixed(2);\r\n        document.getElementById('totalDisplay').textContent =\r\n            'Rs. ' + parseFloat(total).toLocaleString('en-LK', {minimumFractionDigits:2});\r\n    }\r\n\r\n    function changeQty(delta) {\r\n        qty = Math.max(1, qty + delta);\r\n        updateDisplay();\r\n    }\r\n\r\n    // Toggle address section\r\n    document.querySelectorAll('input[name=\"deliveryType\"]').forEach(r => {\r\n        r.addEventListener('change', () => {\r\n            document.getElementById('addressSection').style.display =\r\n                r.value === 'PICKUP' ? 'none' : 'block';\r\n        });\r\n    });\r\n\r\n    updateDisplay();\r\n</script>\r\n</body>\r\n</html>
