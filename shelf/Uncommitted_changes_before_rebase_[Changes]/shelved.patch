<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title>Our Brownies – Sugar Corner</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,500&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root {\r\n            --brown-dark:#2C1810; --brown-mid:#5C3317; --brown-warm:#8B4513;\r\n            --caramel:#C68642; --cream:#FDF6EC; --cream-dark:#F5E6D0;\r\n            --white:#FFFEF9; --text-dark:#1A0F08; --text-muted:#7A5C45;\r\n            --success:#27AE60; --error:#C0392B; --sidebar-w:260px;\r\n        }\r\n        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}\r\n        body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--text-dark);display:flex;min-height:100vh;}\r\n\r\n        /* ── Sidebar ── */\r\n        .sidebar{width:var(--sidebar-w);background:linear-gradient(175deg,var(--brown-dark),var(--brown-mid));\r\n            position:fixed;top:0;left:0;height:100vh;display:flex;flex-direction:column;padding:32px 0;z-index:100;}\r\n        .sidebar-brand{text-align:center;padding:0 24px 32px;border-bottom:1px solid rgba(255,255,255,.1);}\r\n        .sidebar-brand .logo{font-size:38px;display:block;margin-bottom:8px;}\r\n        .sidebar-brand h2{font-family:'Playfair Display',serif;color:var(--cream);font-size:1.3rem;}\r\n        .sidebar-brand small{color:var(--caramel);font-size:.75rem;letter-spacing:1px;text-transform:uppercase;}\r\n        .user-card{margin:20px 16px;background:rgba(255,255,255,.07);border-radius:14px;padding:14px;\r\n            display:flex;align-items:center;gap:10px;}\r\n        .user-avatar{width:42px;height:42px;border-radius:50%;\r\n            background:linear-gradient(135deg,var(--caramel),var(--brown-warm));\r\n            display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:600;color:var(--cream);flex-shrink:0;overflow:hidden;}\r\n        .user-avatar img{width:100%;height:100%;object-fit:cover;}\r\n        .user-name{color:var(--cream);font-size:.88rem;font-weight:500;}\r\n        .user-role{color:var(--caramel);font-size:.7rem;}\r\n        nav{flex:1;padding:8px 16px;overflow-y:auto;}\r\n        .nav-section{font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(253,246,236,.4);padding:14px 12px 5px;}\r\n        .nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:12px;margin-bottom:3px;\r\n            color:rgba(253,246,236,.8);font-size:.87rem;text-decoration:none;transition:all .2s;}\r\n        .nav-item:hover,.nav-item.active{background:rgba(196,134,66,.25);color:var(--cream);}\r\n        .nav-icon{font-size:16px;width:20px;text-align:center;}\r\n        .sidebar-footer{padding:0 16px 16px;}\r\n        .logout-btn{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;\r\n            color:rgba(253,246,236,.6);font-size:.85rem;text-decoration:none;\r\n            border:1px solid rgba(255,255,255,.1);transition:all .2s;}\r\n        .logout-btn:hover{background:rgba(192,57,43,.25);color:#FF8A80;border-color:rgba(192,57,43,.4);}\r\n\r\n        /* ── Main ── */\r\n        .main{margin-left:var(--sidebar-w);flex:1;}\r\n        .topbar{background:var(--white);padding:18px 36px;border-bottom:1px solid var(--cream-dark);\r\n            display:flex;align-items:center;justify-content:space-between;\r\n            position:sticky;top:0;z-index:50;box-shadow:0 2px 12px rgba(44,24,16,.06);}\r\n        .topbar h1{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--brown-dark);}\r\n        .topbar-right{display:flex;align-items:center;gap:10px;}\r\n        .content{padding:32px 36px;}\r\n\r\n        /* ── Featured Banner ── */\r\n        .featured-section{margin-bottom:36px;}\r\n        .section-title{font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--brown-dark);\r\n            margin-bottom:16px;display:flex;align-items:center;gap:8px;}\r\n        .featured-scroll{display:flex;gap:16px;overflow-x:auto;padding-bottom:8px;scrollbar-width:thin;}\r\n        .featured-scroll::-webkit-scrollbar{height:4px;}\r\n        .featured-scroll::-webkit-scrollbar-thumb{background:var(--caramel);border-radius:4px;}\r\n\r\n        /* ── Search & Filter Bar ── */\r\n        .filter-bar{\r\n            background:var(--white);border-radius:16px;padding:20px 24px;\r\n            border:1px solid var(--cream-dark);margin-bottom:24px;\r\n            display:flex;align-items:center;gap:14px;flex-wrap:wrap;\r\n            animation:fadeSlideUp .4s ease both;\r\n        }\r\n        .search-wrap{position:relative;flex:1;min-width:200px;}\r\n        .search-wrap .icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--caramel);font-size:15px;}\r\n        .search-wrap input{width:100%;padding:10px 12px 10px 38px;\r\n            border:1.5px solid #E8D8C4;border-radius:10px;font-family:inherit;font-size:.875rem;\r\n            color:var(--text-dark);background:var(--cream);outline:none;transition:all .2s;}\r\n        .search-wrap input:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(196,134,66,.1);}\r\n        select.filter-sel{padding:10px 14px;border:1.5px solid #E8D8C4;border-radius:10px;\r\n            font-family:inherit;font-size:.875rem;color:var(--text-dark);background:var(--cream);\r\n            outline:none;cursor:pointer;transition:all .2s;}\r\n        select.filter-sel:focus{border-color:var(--caramel);}\r\n        .btn-filter{padding:10px 22px;background:var(--brown-warm);color:var(--cream);\r\n            border:none;border-radius:10px;font-family:inherit;font-size:.875rem;font-weight:500;\r\n            cursor:pointer;transition:all .2s;}\r\n        .btn-filter:hover{background:var(--brown-mid);transform:translateY(-1px);}\r\n        .btn-clear{padding:10px 16px;background:transparent;color:var(--text-muted);\r\n            border:1.5px solid #E8D8C4;border-radius:10px;font-family:inherit;font-size:.875rem;\r\n            cursor:pointer;text-decoration:none;display:flex;align-items:center;}\r\n        .btn-clear:hover{border-color:var(--caramel);color:var(--brown-warm);}\r\n\r\n        /* ── Product Grid ── */\r\n        .products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;}\r\n\r\n        .product-card{\r\n            background:var(--white);border-radius:18px;overflow:hidden;\r\n            border:1px solid var(--cream-dark);transition:all .25s;\r\n            animation:fadeSlideUp .4s ease both;\r\n            display:flex;flex-direction:column;\r\n        }\r\n        .product-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(44,24,16,.12);border-color:var(--caramel);}\r\n\r\n        .product-img{width:100%;height:190px;object-fit:cover;background:var(--cream-dark);\r\n            display:flex;align-items:center;justify-content:center;font-size:64px;position:relative;}\r\n        .product-img img{width:100%;height:100%;object-fit:cover;}\r\n        .product-img-placeholder{width:100%;height:190px;background:linear-gradient(135deg,var(--cream-dark),#e8d0b0);\r\n            display:flex;align-items:center;justify-content:center;font-size:64px;}\r\n\r\n        .featured-ribbon{position:absolute;top:12px;left:12px;\r\n            background:linear-gradient(135deg,var(--caramel),var(--brown-warm));\r\n            color:var(--white);font-size:.7rem;font-weight:600;letter-spacing:.5px;text-transform:uppercase;\r\n            padding:4px 10px;border-radius:100px;}\r\n\r\n        .stock-badge{position:absolute;top:12px;right:12px;padding:4px 10px;border-radius:100px;\r\n            font-size:.7rem;font-weight:600;letter-spacing:.3px;}\r\n        .stock-in   {background:rgba(39,174,96,.15);color:var(--success);}\r\n        .stock-low  {background:rgba(230,126,34,.15);color:#E67E22;}\r\n        .stock-out  {background:rgba(192,57,43,.12);color:var(--error);}\r\n\r\n        .product-body{padding:16px;flex:1;display:flex;flex-direction:column;}\r\n        .product-cat{font-size:.72rem;font-weight:500;letter-spacing:1px;text-transform:uppercase;\r\n            color:var(--caramel);margin-bottom:6px;}\r\n        .product-name{font-family:'Playfair Display',serif;font-size:1.05rem;color:var(--brown-dark);\r\n            margin-bottom:6px;line-height:1.3;}\r\n        .product-desc{font-size:.82rem;color:var(--text-muted);line-height:1.5;flex:1;\r\n            display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}\r\n        .product-footer{display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding-top:12px;\r\n            border-top:1px solid var(--cream-dark);}\r\n        .product-price{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--brown-dark);font-weight:700;}\r\n        .product-price span{font-size:.75rem;font-weight:400;color:var(--text-muted);}\r\n        .btn-view{padding:8px 18px;background:linear-gradient(135deg,var(--brown-warm),var(--brown-mid));\r\n            color:var(--cream);border:none;border-radius:9px;font-family:inherit;font-size:.82rem;\r\n            font-weight:500;cursor:pointer;text-decoration:none;transition:all .2s;}\r\n        .btn-view:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(92,51,23,.3);}\r\n        .btn-view.disabled{background:#ccc;color:#999;cursor:not-allowed;pointer-events:none;}\r\n\r\n        /* ── Featured card (horizontal mini) ── */\r\n        .feat-card{\r\n            flex-shrink:0;width:200px;background:var(--white);border-radius:14px;\r\n            border:1px solid var(--cream-dark);overflow:hidden;transition:all .2s;\r\n        }\r\n        .feat-card:hover{transform:translateY(-4px);box-shadow:0 10px 28px rgba(44,24,16,.1);border-color:var(--caramel);}\r\n        .feat-img{height:110px;background:linear-gradient(135deg,var(--cream-dark),#e8d0b0);\r\n            display:flex;align-items:center;justify-content:center;font-size:42px;position:relative;overflow:hidden;}\r\n        .feat-img img{width:100%;height:100%;object-fit:cover;}\r\n        .feat-body{padding:10px 12px;}\r\n        .feat-name{font-family:'Playfair Display',serif;font-size:.9rem;color:var(--brown-dark);}\r\n        .feat-price{color:var(--caramel);font-weight:600;font-size:.88rem;margin-top:2px;}\r\n\r\n        /* Empty state */\r\n        .empty-state{text-align:center;padding:60px 20px;background:var(--white);border-radius:18px;border:1px solid var(--cream-dark);}\r\n        .empty-state .icon{font-size:56px;margin-bottom:12px;}\r\n        .empty-state h3{font-family:'Playfair Display',serif;color:var(--brown-dark);margin-bottom:6px;}\r\n        .empty-state p{color:var(--text-muted);font-size:.875rem;}\r\n\r\n        .result-count{color:var(--text-muted);font-size:.85rem;margin-bottom:18px;}\r\n        .result-count strong{color:var(--brown-dark);}\r\n\r\n        @keyframes fadeSlideUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}\r\n\r\n        @media(max-width:900px){.sidebar{display:none;}.main{margin-left:0;}}\r\n        @media(max-width:580px){.content{padding:20px;}.products-grid{grid-template-columns:1fr 1fr;}}\r\n        @media(max-width:420px){.products-grid{grid-template-columns:1fr;}}\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- SIDEBAR -->\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <small>Customer Portal</small>\r\n    </div>\r\n\r\n    <!-- Show user card only when logged in -->\r\n    <div class=\"user-card\" th:if=\"${customer != null}\">\r\n        <div class=\"user-avatar\">\r\n            <img th:if=\"${customer.profilePhotoPath}\" th:src=\"'/' + ${customer.profilePhotoPath}\" alt=\"photo\"/>\r\n            <span th:unless=\"${customer.profilePhotoPath}\" th:text=\"${customer.firstName?.substring(0,1)?.toUpperCase()}\">K</span>\r\n        </div>\r\n        <div>\r\n            <div class=\"user-name\" th:text=\"${customer.firstName + ' ' + customer.lastName}\">Kasun Perera</div>\r\n            <div class=\"user-role\">Customer</div>\r\n        </div>\r\n    </div>\r\n\r\n    <nav>\r\n        <div class=\"nav-section\">Main Menu</div>\r\n        <a class=\"nav-item\" href=\"/customer/dashboard\"><span class=\"nav-icon\">\uD83C\uDFE0</span> Dashboard</a>\r\n        <a class=\"nav-item\" href=\"/customer/profile\"><span class=\"nav-icon\">\uD83D\uDC64</span> My Profile</a>\r\n\r\n        <div class=\"nav-section\">Shop</div>\r\n        <a class=\"nav-item active\" href=\"/products\"><span class=\"nav-icon\">\uD83C\uDF6B</span> Browse Brownies</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCE6</span> My Orders</a>\r\n\r\n        <div class=\"nav-section\">Support</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCAC</span> Contact Us</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">⭐</span> My Feedback</a>\r\n    </nav>\r\n\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" th:if=\"${customer != null}\" href=\"/logout\"><span>\uD83D\uDEAA</span> Sign Out</a>\r\n        <a class=\"logout-btn\" th:if=\"${customer == null}\" href=\"/login\"><span>\uD83D\uDD10</span> Sign In</a>\r\n    </div>\r\n</aside>\r\n\r\n<!-- MAIN -->\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <h1>Our Brownies</h1>\r\n        <div class=\"topbar-right\">\r\n      <span style=\"font-size:.85rem;color:var(--text-muted);\" th:if=\"${customer != null}\"\r\n            th:text=\"'Hello, ' + ${customer.firstName} + '! \uD83D\uDC4B'\"></span>\r\n            <a th:if=\"${customer == null}\" href=\"/login\"\r\n               style=\"padding:8px 20px;background:var(--brown-warm);color:var(--cream);border-radius:9px;text-decoration:none;font-size:.85rem;font-weight:500;\">\r\n                Sign In\r\n            </a>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"content\">\r\n\r\n        <!-- Featured Section -->\r\n        <div class=\"featured-section\">\r\n            <div class=\"section-title\">⭐ Featured Brownies</div>\r\n            <div class=\"featured-scroll\">\r\n                <a th:each=\"p : ${featured}\" th:href=\"'/products/' + ${p.id}\" class=\"feat-card\" style=\"text-decoration:none;\">\r\n                    <div class=\"feat-img\">\r\n                        <img th:if=\"${p.imagePath}\" th:src=\"'/' + ${p.imagePath}\" th:alt=\"${p.name}\"/>\r\n                        <span th:unless=\"${p.imagePath}\">\uD83C\uDF6B</span>\r\n                    </div>\r\n                    <div class=\"feat-body\">\r\n                        <div class=\"feat-name\" th:text=\"${p.name}\">Brownie</div>\r\n                        <div class=\"feat-price\" th:text=\"'Rs. ' + ${#numbers.formatDecimal(p.price,1,'COMMA',2,'POINT')}\">Rs. 350.00</div>\r\n                    </div>\r\n                </a>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Search & Filter Bar -->\r\n        <form class=\"filter-bar\" method=\"GET\" action=\"/products\">\r\n            <div class=\"search-wrap\">\r\n                <span class=\"icon\">\uD83D\uDD0D</span>\r\n                <input type=\"text\" name=\"search\" placeholder=\"Search brownies by name…\"\r\n                       th:value=\"${search}\" autocomplete=\"off\"/>\r\n            </div>\r\n            <select name=\"category\" class=\"filter-sel\">\r\n                <option value=\"\">All Categories</option>\r\n                <option th:each=\"cat : ${categories}\"\r\n                        th:value=\"${cat}\" th:text=\"${cat}\"\r\n                        th:selected=\"${cat == category}\">Category</option>\r\n            </select>\r\n            <select name=\"maxPrice\" class=\"filter-sel\">\r\n                <option value=\"\">Any Price</option>\r\n                <option value=\"350\"  th:selected=\"${maxPrice == 350}\">Up to Rs. 350</option>\r\n                <option value=\"400\"  th:selected=\"${maxPrice == 400}\">Up to Rs. 400</option>\r\n                <option value=\"450\"  th:selected=\"${maxPrice == 450}\">Up to Rs. 450</option>\r\n                <option value=\"500\"  th:selected=\"${maxPrice == 500}\">Up to Rs. 500</option>\r\n            </select>\r\n            <button type=\"submit\" class=\"btn-filter\">\uD83D\uDD0E Filter</button>\r\n            <a href=\"/products\" class=\"btn-clear\">✕ Clear</a>\r\n        </form>\r\n\r\n        <!-- Result count -->\r\n        <div class=\"result-count\">\r\n            Showing <strong th:text=\"${products.size()}\">0</strong> brownie(s)\r\n            <span th:if=\"${search != null and search != ''}\"> for \"<strong th:text=\"${search}\"></strong>\"</span>\r\n        </div>\r\n\r\n        <!-- Product Grid -->\r\n        <div class=\"products-grid\">\r\n            <div th:each=\"p,i : ${products}\" class=\"product-card\"\r\n                 th:style=\"'animation-delay:' + ${i.index * 0.05} + 's'\">\r\n\r\n                <!-- Image -->\r\n                <div style=\"position:relative;\">\r\n                    <div class=\"product-img-placeholder\" th:unless=\"${p.imagePath}\">\uD83C\uDF6B</div>\r\n                    <div th:if=\"${p.imagePath}\" style=\"height:190px;overflow:hidden;\">\r\n                        <img th:src=\"'/' + ${p.imagePath}\" th:alt=\"${p.name}\"\r\n                             style=\"width:100%;height:100%;object-fit:cover;\"/>\r\n                    </div>\r\n\r\n                    <!-- Featured ribbon -->\r\n                    <div class=\"featured-ribbon\" th:if=\"${p.featured}\">⭐ Popular</div>\r\n\r\n                    <!-- Stock badge -->\r\n                    <div th:if=\"${p.stockLabel == 'In Stock'}\"  class=\"stock-badge stock-in\">● In Stock</div>\r\n                    <div th:if=\"${p.stockLabel == 'Low Stock'}\" class=\"stock-badge stock-low\">● Low Stock</div>\r\n                    <div th:if=\"${p.stockLabel == 'Out of Stock'}\" class=\"stock-badge stock-out\">● Out of Stock</div>\r\n                </div>\r\n\r\n                <!-- Body -->\r\n                <div class=\"product-body\">\r\n                    <div class=\"product-cat\" th:text=\"${p.category}\">Classic</div>\r\n                    <div class=\"product-name\" th:text=\"${p.name}\">Brownie Name</div>\r\n                    <div class=\"product-desc\" th:text=\"${p.description}\">Description here.</div>\r\n                    <div class=\"product-footer\">\r\n                        <div class=\"product-price\">\r\n                            Rs. <span th:text=\"${#numbers.formatDecimal(p.price,1,'COMMA',2,'POINT')}\">350.00</span>\r\n                        </div>\r\n                        <a th:if=\"${p.inStock}\" th:href=\"'/products/' + ${p.id}\" class=\"btn-view\">View →</a>\r\n                        <span th:unless=\"${p.inStock}\" class=\"btn-view disabled\">Sold Out</span>\r\n                    </div>\r\n                </div>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Empty state -->\r\n        <div class=\"empty-state\">\r\n            <div class=\"icon\">\uD83D\uDD0D</div>\r\n            <h3>No brownies found</h3>\r\n            <p>Try a different search term or clear the filters.</p>\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n</body>\r\n</html>
