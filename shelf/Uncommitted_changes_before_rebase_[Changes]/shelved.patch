teClock() {\r\n        document.getElementById('clock').textContent = new Date().toLocaleString('en-LK',{\r\n            weekday:'short',year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'\r\n        });\r\n    }\r\n    updateClock(); setInterval(updateClock,1000);\r\n</script>\r\n</body>\r\n</html>
