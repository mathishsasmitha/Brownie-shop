<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title>Admin Dashboard – Sugar Corner</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root {\r\n            --dark: #111; --dark2: #1a1a1a; --dark3: #222;\r\n            --accent: #C68642; --accent2: #8B4513; --gold: #D4A843;\r\n            --cream: #FDF6EC; --white: #fff; --muted: #888;\r\n            --sidebar-w: 260px; --success: #51CF66; --error: #FF6B6B; --warning: #FFA94D;\r\n            --border: rgba(255,255,255,.07);\r\n        }\r\n        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n        body { font-family: 'DM Sans', sans-serif; background: #0f0f0f; color: #e8e0d8; display: flex; min-height: 100vh; }\r\n\r\n        /* ── Admin Sidebar ── */\r\n        .sidebar {\r\n            width: var(--sidebar-w); background: var(--dark);\r\n            position: fixed; top: 0; left: 0; height: 100vh;\r\n            display: flex; flex-direction: column; padding: 28px 0;\r\n            border-right: 1px solid var(--border); z-index: 100;\r\n            animation: slideIn .5s ease;\r\n        }\r\n        @keyframes slideIn { from{transform:translateX(-100%);} to{transform:translateX(0);} }\r\n\r\n        .sidebar-brand { text-align:center; padding:0 24px 28px; border-bottom:1px solid var(--border); }\r\n        .sidebar-brand .logo { font-size:36px; display:block; margin-bottom:8px; }\r\n        .sidebar-brand h2 { font-family:'Playfair Display',serif; font-size:1.25rem;\r\n            background:linear-gradient(135deg, var(--cream), var(--accent));\r\n            -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\r\n        .sidebar-brand .role-badge {\r\n            display:inline-block; margin-top:6px; padding:3px 12px;\r\n            background:rgba(196,134,66,.2); color:var(--accent);\r\n            border:1px solid rgba(196,134,66,.3);\r\n            border-radius:100px; font-size:.7rem; letter-spacing:1px; text-transform:uppercase;\r\n        }\r\n\r\n        .admin-info { margin:20px 16px; background:rgba(196,134,66,.08);\r\n            border:1px solid rgba(196,134,66,.15); border-radius:14px; padding:14px; display:flex; align-items:center; gap:12px; }\r\n        .admin-avatar { width:42px; height:42px; border-radius:50%;\r\n            background:linear-gradient(135deg, var(--accent2), var(--accent));\r\n            display:flex; align-items:center; justify-content:center; font-size:16px; color:var(--white); font-weight:600; flex-shrink:0; }\r\n        .admin-name  { font-size:.88rem; color:var(--cream); font-weight:500; }\r\n        .admin-role  { font-size:.72rem; color:var(--accent); }\r\n\r\n        nav { flex:1; padding:8px 16px; overflow-y:auto; }\r\n        .nav-section { font-size:.65rem; letter-spacing:1.5px; text-transform:uppercase; color:rgba(255,255,255,.25); padding:16px 12px 6px; }\r\n        .nav-item { display:flex; align-items:center; gap:12px; padding:10px 14px; border-radius:10px; margin-bottom:3px;\r\n            color:rgba(255,255,255,.55); font-size:.86rem; text-decoration:none; transition:all .2s; }\r\n        .nav-item:hover,.nav-item.active { background:rgba(196,134,66,.15); color:var(--cream); }\r\n        .nav-item.active { border-left:3px solid var(--accent); padding-left:11px; }\r\n        .nav-icon { font-size:16px; width:20px; text-align:center; }\r\n        .nav-badge { margin-left:auto; padding:2px 8px; background:rgba(255,107,107,.25);\r\n            color:#FF8A80; border-radius:100px; font-size:.7rem; }\r\n\r\n        .sidebar-footer { padding:0 16px 16px; border-top:1px solid var(--border); padding-top:16px; }\r\n        .logout-btn { display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:10px;\r\n            color:rgba(255,255,255,.4); font-size:.84rem; text-decoration:none; transition:all .2s; }\r\n        .logout-btn:hover { background:rgba(255,107,107,.1); color:#FF8A80; }\r\n\r\n        /* ── Main ── */\r\n        .main { margin-left:var(--sidebar-w); flex:1; }\r\n\r\n        .topbar {\r\n            background:var(--dark2); padding:18px 36px;\r\n            border-bottom:1px solid var(--border);\r\n            display:flex; align-items:center; justify-content:space-between;\r\n            position:sticky; top:0; z-index:50;\r\n        }\r\n        .topbar h1 { font-family:'Playfair Display',serif; font-size:1.4rem; color:var(--cream); }\r\n        .topbar-right { display:flex; align-items:center; gap:16px; }\r\n        .topbar-time  { color:var(--muted); font-size:.82rem; }\r\n        .notif-btn { width:36px; height:36px; border-radius:10px;\r\n            background:rgba(196,134,66,.15); border:1px solid rgba(196,134,66,.2);\r\n            display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px; }\r\n\r\n        .content { padding:32px 36px; }\r\n\r\n        /* ── Stats ── */\r\n        .stats-row { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-bottom:28px; }\r\n        .stat-card {\r\n            background:var(--dark2); border-radius:16px; padding:22px;\r\n            border:1px solid var(--border); position:relative; overflow:hidden;\r\n            transition:transform .2s, border-color .2s;\r\n            animation:fadeSlideUp .5s ease both;\r\n        }\r\n        .stat-card:nth-child(1){animation-delay:.05s;} .stat-card:nth-child(2){animation-delay:.1s;}\r\n        .stat-card:nth-child(3){animation-delay:.15s;} .stat-card:nth-child(4){animation-delay:.2s;}\r\n        .stat-card:hover { transform:translateY(-4px); border-color:rgba(196,134,66,.3); }\r\n        .stat-card::after { content:attr(data-emoji); position:absolute; right:-8px; bottom:-12px; font-size:60px; opacity:.08; }\r\n        .stat-label  { font-size:.75rem; color:var(--muted); text-transform:uppercase; letter-spacing:1px; }\r\n        .stat-num    { font-family:'Playfair Display',serif; font-size:2.4rem; color:var(--cream); margin:8px 0 4px; }\r\n        .stat-change { font-size:.75rem; }\r\n        .stat-change.up   { color:var(--success); }\r\n        .stat-change.down { color:var(--error); }\r\n\r\n        /* ── Quick Actions ── */\r\n        .section-row { display:grid; grid-template-columns:2fr 1fr; gap:20px; margin-bottom:24px; }\r\n        .panel { background:var(--dark2); border-radius:16px; padding:26px; border:1px solid var(--border); animation:fadeSlideUp .5s ease both .25s; }\r\n        .panel h3 { font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--cream); margin-bottom:18px; }\r\n\r\n        .action-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }\r\n        .action-btn {\r\n            display:flex; align-items:center; gap:12px; padding:16px;\r\n            background:rgba(255,255,255,.03); border:1px solid var(--border);\r\n            border-radius:12px; text-decoration:none; cursor:pointer;\r\n            transition:all .2s;\r\n        }\r\n        .action-btn:hover { background:rgba(196,134,66,.1); border-color:rgba(196,134,66,.3); }\r\n        .action-emoji { font-size:24px; }\r\n        .action-label { font-size:.85rem; color:var(--cream); font-weight:500; }\r\n        .action-sub   { font-size:.75rem; color:var(--muted); margin-top:2px; }\r\n\r\n        /* Summary panel */\r\n        .summary-list { list-style:none; }\r\n        .summary-item { display:flex; align-items:center; justify-content:space-between;\r\n            padding:10px 0; border-bottom:1px solid rgba(255,255,255,.04); }\r\n        .summary-item:last-child { border-bottom:none; }\r\n        .summary-label { font-size:.85rem; color:rgba(255,255,255,.65); }\r\n        .summary-val   { font-weight:600; font-size:.9rem; color:var(--cream); }\r\n        .chip { padding:2px 10px; border-radius:100px; font-size:.72rem; font-weight:500; }\r\n        .chip-active  { background:rgba(81,207,102,.15); color:var(--success); }\r\n        .chip-blocked { background:rgba(255,107,107,.15); color:var(--error); }\r\n\r\n        @keyframes fadeSlideUp { from{opacity:0;transform:translateY(16px);} to{opacity:1;transform:translateY(0);} }\r\n\r\n        @media (max-width:1100px) { .stats-row{grid-template-columns:repeat(2,1fr);} .section-row{grid-template-columns:1fr;} }\r\n        @media (max-width:900px)  { .sidebar{display:none;} .main{margin-left:0;} }\r\n        @media (max-width:580px)  { .stats-row{grid-template-columns:1fr;} .content{padding:20px;} }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- SIDEBAR -->\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <span class=\"role-badge\">Admin Panel</span>\r\n    </div>\r\n\r\n    <div class=\"admin-info\">\r\n        <div class=\"admin-avatar\">A</div>\r\n        <div>\r\n            <div class=\"admin-name\" th:text=\"${admin.firstName + ' ' + admin.lastName}\">Admin</div>\r\n            <div class=\"admin-role\">\uD83D\uDEE1\uFE0F Administrator</div>\r\n        </div>\r\n    </div>\r\n\r\n    <nav>\r\n        <div class=\"nav-section\">Overview</div>\r\n        <a class=\"nav-item active\" href=\"/admin/dashboard\"><span class=\"nav-icon\">\uD83D\uDCCA</span> Dashboard</a>\r\n\r\n        <div class=\"nav-section\">Customer Mgmt</div>\r\n        <a class=\"nav-item\" href=\"/admin/customers\"><span class=\"nav-icon\">\uD83D\uDC65</span> All Customers</a>\r\n\r\n        <div class=\"nav-section\">Product Mgmt</div>\r\n        <a class=\"nav-item\" href=\"/admin/products\"><span class=\"nav-icon\">\uD83C\uDF6B</span> All Products</a>\r\n        <a class=\"nav-item\" href=\"/admin/products/add\"><span class=\"nav-icon\">➕</span> Add Product</a>\r\n\r\n        <div class=\"nav-section\">Coming Soon</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCE6</span> Orders <span class=\"nav-badge\">0</span></a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCB3</span> Payments</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCAC</span> Inquiries</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">⭐</span> Feedback</a>\r\n    </nav>\r\n\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" href=\"/logout\"><span>\uD83D\uDEAA</span> Sign Out</a>\r\n    </div>\r\n</aside>\r\n\r\n<!-- MAIN -->\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <h1>Dashboard Overview</h1>\r\n        <div class=\"topbar-right\">\r\n            <span class=\"topbar-time\" id=\"clock\">–</span>\r\n            <div class=\"notif-btn\">\uD83D\uDD14</div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"content\">\r\n\r\n        <!-- Stats Row -->\r\n        <div class=\"stats-row\">\r\n            <div class=\"stat-card\" data-emoji=\"\uD83D\uDC65\">\r\n                <div class=\"stat-label\">Total Customers</div>\r\n                <div class=\"stat-num\" th:text=\"${totalCustomers}\">0</div>\r\n                <div class=\"stat-change up\">Module 1 Active ✓</div>\r\n            </div>\r\n            <div class=\"stat-card\" data-emoji=\"✅\">\r\n                <div class=\"stat-label\">Active Accounts</div>\r\n                <div class=\"stat-num\" th:text=\"${activeCustomers}\">0</div>\r\n                <div class=\"stat-change up\">↑ All good</div>\r\n            </div>\r\n            <div class=\"stat-card\" data-emoji=\"\uD83D\uDEAB\">\r\n                <div class=\"stat-label\">Blocked Accounts</div>\r\n                <div class=\"stat-num\" th:text=\"${blockedCustomers}\">0</div>\r\n                <div class=\"stat-change\" th:classappend=\"${blockedCustomers > 0} ? 'down' : 'up'\">\r\n                    <span th:text=\"${blockedCustomers > 0} ? '⚠ Needs attention' : '✓ None blocked'\">✓ None blocked</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"stat-card\" data-emoji=\"\uD83C\uDF6B\">\r\n                <div class=\"stat-label\">Total Products</div>\r\n                <div class=\"stat-num\" th:text=\"${totalProducts}\">0</div>\r\n                <div class=\"stat-change up\">Module 2 Active ✓</div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"section-row\">\r\n            <!-- Quick Actions -->\r\n            <div class=\"panel\">\r\n                <h3>Quick Actions</h3>\r\n                <div class=\"action-grid\">\r\n                    <a class=\"action-btn\" href=\"/admin/customers\">\r\n                        <span class=\"action-emoji\">\uD83D\uDC65</span>\r\n                        <div>\r\n                            <div class=\"action-label\">Manage Customers</div>\r\n                            <div class=\"action-sub\">View, block or unblock</div>\r\n                        </div>\r\n                    </a>\r\n                    <a class=\"action-btn\" href=\"/admin/products/add\">\r\n                        <span class=\"action-emoji\">\uD83C\uDF6B</span>\r\n                        <div>\r\n                            <div class=\"action-label\">Add Product</div>\r\n                            <div class=\"action-sub\">Add a new brownie to shop</div>\r\n                        </div>\r\n                    </a>\r\n                    <a class=\"action-btn\" href=\"#\">\r\n                        <span class=\"action-emoji\">\uD83D\uDCE6</span>\r\n                        <div>\r\n                            <div class=\"action-label\">View Orders</div>\r\n                            <div class=\"action-sub\">Coming in Module 3</div>\r\n                        </div>\r\n                    </a>\r\n                    <a class=\"