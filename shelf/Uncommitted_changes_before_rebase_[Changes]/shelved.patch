<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title>Orders – Sugar Corner Admin</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root{--dark:#111;--dark2:#1a1a1a;--accent:#C68642;--accent2:#8B4513;--gold:#D4A843;\r\n            --cream:#FDF6EC;--muted:#888;--sidebar-w:260px;\r\n            --success:#51CF66;--error:#FF6B6B;--warn:#FFA94D;--border:rgba(255,255,255,.07);}\r\n        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}\r\n        body{font-family:'DM Sans',sans-serif;background:#0f0f0f;color:#e8e0d8;display:flex;min-height:100vh;}\r\n        .sidebar{width:var(--sidebar-w);background:var(--dark);position:fixed;top:0;left:0;height:100vh;\r\n            display:flex;flex-direction:column;padding:28px 0;border-right:1px solid var(--border);z-index:100;}\r\n        .sidebar-brand{text-align:center;padding:0 24px 28px;border-bottom:1px solid var(--border);}\r\n        .sidebar-brand .logo{font-size:36px;display:block;margin-bottom:8px;}\r\n        .sidebar-brand h2{font-family:'Playfair Display',serif;font-size:1.25rem;\r\n            background:linear-gradient(135deg,var(--cream),var(--accent));\r\n            -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}\r\n        .role-badge{display:inline-block;margin-top:6px;padding:3px 12px;\r\n            background:rgba(196,134,66,.2);color:var(--accent);border:1px solid rgba(196,134,66,.3);\r\n            border-radius:100px;font-size:.7rem;letter-spacing:1px;text-transform:uppercase;}\r\n        nav{flex:1;padding:8px 16px;overflow-y:auto;}\r\n        .nav-section{font-size:.65rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.25);padding:16px 12px 6px;}\r\n        .nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;margin-bottom:3px;\r\n            color:rgba(255,255,255,.55);font-size:.86rem;text-decoration:none;transition:all .2s;}\r\n        .nav-item:hover,.nav-item.active{background:rgba(196,134,66,.15);color:var(--cream);}\r\n        .nav-item.active{border-left:3px solid var(--accent);padding-left:11px;}\r\n        .nav-icon{font-size:16px;width:20px;text-align:center;}\r\n        .nav-badge{margin-left:auto;padding:2px 8px;background:rgba(255,107,107,.25);color:#FF8A80;border-radius:100px;font-size:.7rem;}\r\n        .sidebar-footer{padding:16px;border-top:1px solid var(--border);}\r\n        .logout-btn{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;\r\n            color:rgba(255,255,255,.4);font-size:.84rem;text-decoration:none;transition:all .2s;}\r\n        .logout-btn:hover{background:rgba(255,107,107,.1);color:#FF8A80;}\r\n        .main{margin-left:var(--sidebar-w);flex:1;}\r\n        .topbar{background:var(--dark2);padding:18px 36px;border-bottom:1px solid var(--border);\r\n            display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;}\r\n        .topbar-left{display:flex;align-items:center;gap:10px;}\r\n        .topbar-left a{color:var(--muted);font-size:.84rem;text-decoration:none;}\r\n        .topbar-left a:hover{color:var(--accent);}\r\n        .topbar-left .sep{color:var(--muted);}\r\n        .topbar h1{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--cream);}\r\n        .notif-wrap{position:relative;display:inline-block;}\r\n        .notif-btn{width:38px;height:38px;border-radius:10px;background:rgba(196,134,66,.15);\r\n            border:1px solid rgba(196,134,66,.2);display:flex;align-items:center;justify-content:center;font-size:16px;}\r\n        .notif-dot{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;border-radius:100px;\r\n            background:#FF6B6B;color:white;font-size:.65rem;font-weight:700;\r\n            display:flex;align-items:center;justify-content:center;padding:0 4px;}\r\n        .content{padding:28px 36px;}\r\n\r\n        /* Notification banner */\r\n        .notif-banner{background:rgba(255,107,107,.08);border:1px solid rgba(255,107,107,.2);\r\n            border-radius:12px;padding:14px 18px;margin-bottom:20px;\r\n            display:flex;align-items:center;gap:10px;font-size:.875rem;color:#FF8A80;}\r\n        .notif-banner strong{color:#FF6B6B;}\r\n\r\n        /* Stats strip */\r\n        .stats-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px;}\r\n        .stat-mini{background:var(--dark2);border-radius:12px;border:1px solid var(--border);padding:16px 18px;}\r\n        .stat-mini-num{font-family:'Playfair Display',serif;font-size:1.8rem;color:var(--cream);}\r\n        .stat-mini-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:2px;}\r\n\r\n        /* Search bar */\r\n        .search-bar{background:var(--dark2);border-radius:14px;border:1px solid var(--border);\r\n            padding:18px 22px;margin-bottom:20px;display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;}\r\n        .search-field{display:flex;flex-direction:column;gap:6px;flex:1;min-width:160px;}\r\n        .search-field label{font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);}\r\n        .search-field input{padding:9px 12px;background:#222;border:1px solid var(--border);border-radius:9px;\r\n            color:var(--cream);font-family:inherit;font-size:.875rem;outline:none;transition:all .2s;}\r\n        .search-field input:focus{border-color:rgba(196,134,66,.4);}\r\n        .search-field input::placeholder{color:rgba(255,255,255,.2);}\r\n        .btn-search{padding:9px 22px;background:linear-gradient(135deg,var(--accent2),var(--accent));\r\n            color:#fff;border:none;border-radius:9px;font-family:inherit;font-size:.875rem;cursor:pointer;transition:all .2s;}\r\n        .btn-search:hover{transform:translateY(-1px);}\r\n        .btn-clear-s{padding:9px 16px;background:transparent;color:var(--muted);\r\n            border:1px solid var(--border);border-radius:9px;font-family:inherit;font-size:.875rem;\r\n            text-decoration:none;display:flex;align-items:center;transition:all .2s;}\r\n        .btn-clear-s:hover{border-color:rgba(196,134,66,.3);color:var(--accent);}\r\n\r\n        /* Table */\r\n        .table-wrap{background:var(--dark2);border-radius:16px;border:1px solid var(--border);overflow:hidden;}\r\n        table{width:100%;border-collapse:collapse;}\r\n        thead th{padding:13px 16px;text-align:left;font-size:.7rem;font-weight:500;letter-spacing:1px;\r\n            text-transform:uppercase;color:var(--muted);background:rgba(255,255,255,.02);border-bottom:1px solid var(--border);}\r\n        tbody tr{border-bottom:1px solid rgba(255,255,255,.04);transition:background .15s;}\r\n        tbody tr:last-child{border-bottom:none;}\r\n        tbody tr:hover{background:rgba(196,134,66,.04);}\r\n        td{padding:13px 16px;font-size:.875rem;vertical-align:middle;}\r\n\r\n        .customer-cell .c-name{font-weight:500;color:var(--cream);}\r\n        .customer-cell .c-email{font-size:.75rem;color:var(--muted);}\r\n        .items-cell{font-size:.78rem;color:rgba(255,255,255,.6);max-width:180px;}\r\n\r\n        .chip{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:100px;font-size:.72rem;font-weight:600;}\r\n        .chip-orange{background:rgba(230,126,34,.15);color:#E67E22;}\r\n        .chip-blue  {background:rgba(41,128,185,.15);color:#2980B9;}\r\n        .chip-purple{background:rgba(142,68,173,.15);color:#9B59B6;}\r\n        .chip-teal  {background:rgba(26,188,156,.15);color:#1ABC9C;}\r\n        .chip-green {background:rgba(81,207,102,.12);color:var(--success);}\r\n        .chip-red   {background:rgba(255,107,107,.12);color:var(--error);}\r\n        .chip-grey  {background:rgba(255,255,255,.07);color:var(--muted);}\r\n\r\n        .btn-sm{padding:5px 14px;border-radius:7px;font-family:inherit;font-size:.76rem;font-weight:500;\r\n            cursor:pointer;border:none;transition:all .18s;text-decoration:none;display:inline-flex;align-items:center;}\r\n        .btn-view{background:rgba(196,134,66,.15);color:var(--accent);}\r\n        .btn-view:hover{background:rgba(196,134,66,.28);}\r\n\r\n        .empty-state{text-align:center;padding:56px 20px;}\r\n        .empty-state .icon{font-size:44px;margin-bottom:10px;}\r\n        .empty-state p{color:var(--muted);font-size:.9rem;}\r\n\r\n        @media(max-width:900px){.sidebar{display:none;}.main{margin-left:0;}}\r\n        @media(max-width:640px){.content{padding:16px;}.stats-strip{grid-template-columns:1fr 1fr;}}\r\n    </style>\r\n</head>\r\n<body>\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <span class=\"role-badge\">Admin Panel</span>\r\n    </div>\r\n    <nav>\r\n        <div class=\"nav-section\">Overview</div>\r\n        <a class=\"nav-item\" href=\"/admin/dashboard\"><span class=\"nav-icon\">\uD83D\uDCCA</span> Dashboard</a>\r\n        <div class=\"nav-section\">Customer Mgmt</div>\r\n        <a class=\"nav-item\" href=\"/admin/customers\"><span class=\"nav-icon\">\uD83D\uDC65</span> All Customers</a>\r\n        <div class=\"nav-section\">Product Mgmt</div>\r\n        <a class=\"nav-item\" href=\"/admin/products\"><span class=\"nav-icon\">\uD83C\uDF6B</span> All Products</a>\r\n        <a class=\"nav-item\" href=\"/admin/products/add\"><span class=\"nav-icon\">➕</span> Add Product</a>\r\n        <div class=\"nav-section\">Order Mgmt</div>\r\n        <a class=\"nav-item active\" href=\"/admin/orders\"><span class=\"nav-icon\">\uD83D\uDCE6</span> All Orders\r\n            <span class=\"nav-badge\" th:if=\"${pendingCount > 0}\" th:text=\"${pendingCount}\">0</span>\r\n        </a>\r\n        <div class=\"nav-section\">Coming Soon</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCB3</span> Payments</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCAC</span> Inquiries</a>\r\n    </nav>\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" href=\"/logout\"><span>\uD83D\uDEAA</span> Sign Out</a>\r\n    </div>\r\n</aside>\r\n\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <div class=\"topbar-left\">\r\n            <a href=\"/admin/dashboard\">Dashboard</a>\r\n            <span class=\"sep\">›</span>\r\n            <h1>Orders</h1>\r\n        </div>\r\n        <div class=\"notif-wrap\">\r\n            <div class=\"notif-btn\">\uD83D\uDD14</div>\r\n            <div class=\"notif-dot\" th:if=\"${pendingCount > 0}\" th:text=\"${pendingCount}\">0</div>\r\n        </div>\r\n    </div>\r\n    <div class=\"content\">\r\n\r\n        <!-- Notification banner for new pending orders -->\r\n        <div class=\"notif-banner\" th:if=\"${pendingCount > 0}\">\r\n            \uD83D\uDD14 You have <strong th:text=\"${pendingCount}\">0</strong> pending order(s) waiting for confirmation!\r\n            <span th:if=\"${newToday > 0}\" th:text=\"'(' + ${newToday} + ' new today)'\"></span>\r\n        </div>\r\n\r\n        <!-- Stats strip -->\r\n        <div class=\"stats-strip\">\r\n            <div class=\"stat-mini\">\r\n                <div class=\"stat-mini-num\" th:text=\"${orders.size()}\">0</div>\r\n                <div class=\"stat-mini-label\">Showing Orders</div>\r\n            </div>\r\n            <div class=\"stat-mini\">\r\n                <div class=\"stat-mini-num\" th:text=\"${pendingCount}\">0</div>\r\n                <div class=\"stat-mini-label\">⏳ Pending</div>\r\n            </div>\r\n            <div class=\"stat-mini\">\r\n                <div class=\"stat-mini-num\" th:text=\"${newToday}\">0</div>\r\n                <div class=\"stat-mini-label\">\uD83C\uDD95 New Today</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Search bar -->\r\n        <form class=\"search-bar\" method=\"GET\" action=\"/admin/orders\">\r\n            <div class=\"search-field\">\r\n                <label>Search by Order ID</label>\r\n                <input type=\"text\" name=\"orderId\" placeholder=\"e.g. 42\" th:value=\"${searchOrderId}\"/>\r\n            </div>\r\n            <div class=\"search-field\">\r\n                <label>Search by Date</label>\r\n                <input type=\"date\" name=\"date\" th:value=\"${searchDate}\"/>\r\n            </div>\r\n            <button type=\"submit\" class=\"btn-search\">\uD83D\uDD0D Search</button>\r\n            <a href=\"/admin/orders\" class=\"btn-clear-s\">✕ Clear</a>\r\n        </form>\r\n\r\n        <!-- Table -->\r\n        <div class=\"table-wrap\">\r\n            <table>\r\n                <thead>\r\n                <tr>\r\n                    <th>#ID</th>\r\n                    <th>Customer</th>\r\n                    <th>Items</th>\r\n                    <th>Total</th>\r\n                    <th>Type</th>\r\n                    <th>Status</th>\r\n                    <th>Date</th>\r\n                    <th>Action</th>\r\n                </tr>\r\n                </thead>\r\n                <tbody>\r\n                <tr>\r\n                    <td colspan=\"8\">\r\n                        <div class=\"empty-state\">\r\n                            <div class=\"icon\">\uD83D\uDCE6</div>\r\n                            <p>No orders found.</p>\r\n                        </div>\r\n                    </td>\r\n                </tr>\r\n                <tr th:each=\"o : ${orders}\">\r\n                    <td style=\"font-weight:600;color:var(--accent);\" th:text=\"'#' + ${o.id}\">#1</td>\r\n                    <td>\r\n                        <div class=\"customer-cell\">\r\n             