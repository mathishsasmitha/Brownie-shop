<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n    <title th:text=\"'Order #' + ${order.id} + ' – Admin'\">Order Detail</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\"/>\r\n    <style>\r\n        :root{--dark:#111;--dark2:#1a1a1a;--accent:#C68642;--accent2:#8B4513;--gold:#D4A843;\r\n            --cream:#FDF6EC;--muted:#888;--sidebar-w:260px;\r\n            --success:#51CF66;--error:#FF6B6B;--warn:#FFA94D;--border:rgba(255,255,255,.07);}\r\n        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}\r\n        body{font-family:'DM Sans',sans-serif;background:#0f0f0f;color:#e8e0d8;display:flex;min-height:100vh;}\r\n        .sidebar{width:var(--sidebar-w);background:var(--dark);position:fixed;top:0;left:0;height:100vh;\r\n            display:flex;flex-direction:column;padding:28px 0;border-right:1px solid var(--border);z-index:100;}\r\n        .sidebar-brand{text-align:center;padding:0 24px 28px;border-bottom:1px solid var(--border);}\r\n        .sidebar-brand .logo{font-size:36px;display:block;margin-bottom:8px;}\r\n        .sidebar-brand h2{font-family:'Playfair Display',serif;font-size:1.25rem;\r\n            background:linear-gradient(135deg,var(--cream),var(--accent));\r\n            -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}\r\n        .role-badge{display:inline-block;margin-top:6px;padding:3px 12px;background:rgba(196,134,66,.2);\r\n            color:var(--accent);border:1px solid rgba(196,134,66,.3);border-radius:100px;font-size:.7rem;letter-spacing:1px;text-transform:uppercase;}\r\n        nav{flex:1;padding:8px 16px;}\r\n        .nav-section{font-size:.65rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.25);padding:16px 12px 6px;}\r\n        .nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;margin-bottom:3px;\r\n            color:rgba(255,255,255,.55);font-size:.86rem;text-decoration:none;transition:all .2s;}\r\n        .nav-item:hover,.nav-item.active{background:rgba(196,134,66,.15);color:var(--cream);}\r\n        .nav-item.active{border-left:3px solid var(--accent);padding-left:11px;}\r\n        .nav-icon{font-size:16px;width:20px;text-align:center;}\r\n        .nav-badge{margin-left:auto;padding:2px 8px;background:rgba(255,107,107,.25);color:#FF8A80;border-radius:100px;font-size:.7rem;}\r\n        .sidebar-footer{padding:16px;border-top:1px solid var(--border);}\r\n        .logout-btn{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;\r\n            color:rgba(255,255,255,.4);font-size:.84rem;text-decoration:none;transition:all .2s;}\r\n        .logout-btn:hover{background:rgba(255,107,107,.1);color:#FF8A80;}\r\n        .main{margin-left:var(--sidebar-w);flex:1;}\r\n        .topbar{background:var(--dark2);padding:18px 36px;border-bottom:1px solid var(--border);\r\n            display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:50;}\r\n        .topbar a{color:var(--muted);font-size:.84rem;text-decoration:none;}\r\n        .topbar a:hover{color:var(--accent);}\r\n        .topbar .sep{color:var(--muted);}\r\n        .topbar h1{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--cream);}\r\n        .content{padding:28px 36px;max-width:960px;}\r\n\r\n        .alert{padding:12px 18px;border-radius:10px;font-size:.875rem;margin-bottom:18px;\r\n            display:flex;align-items:center;gap:8px;}\r\n        .alert-success{background:rgba(81,207,102,.1);border:1px solid rgba(81,207,102,.25);color:var(--success);}\r\n\r\n        /* Status header card */\r\n        .order-header-card{background:var(--dark2);border-radius:16px;border:1px solid var(--border);\r\n            padding:22px 26px;margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;\r\n            flex-wrap:wrap;gap:16px;animation:fadeSlideUp .4s ease both;}\r\n        .order-id-big{font-family:'Playfair Display',serif;font-size:1.6rem;color:var(--cream);}\r\n        .order-meta{font-size:.8rem;color:var(--muted);margin-top:4px;}\r\n        .chip{display:inline-flex;align-items:center;gap:4px;padding:6px 16px;border-radius:100px;font-size:.78rem;font-weight:600;}\r\n        .chip-orange{background:rgba(230,126,34,.15);color:#E67E22;}\r\n        .chip-blue  {background:rgba(41,128,185,.15);color:#2980B9;}\r\n        .chip-purple{background:rgba(142,68,173,.15);color:#9B59B6;}\r\n        .chip-teal  {background:rgba(26,188,156,.15);color:#1ABC9C;}\r\n        .chip-green {background:rgba(81,207,102,.12);color:var(--success);}\r\n        .chip-red   {background:rgba(255,107,107,.12);color:var(--error);}\r\n\r\n        /* Status update form */\r\n        .status-form{background:var(--dark2);border-radius:14px;border:1px solid var(--border);\r\n            padding:20px 24px;margin-bottom:18px;animation:fadeSlideUp .4s ease both .05s;}\r\n        .status-form h4{font-family:'Playfair Display',serif;font-size:.95rem;color:var(--cream);margin-bottom:14px;}\r\n        .status-grid{display:flex;gap:10px;flex-wrap:wrap;}\r\n        .status-btn{padding:9px 20px;border-radius:10px;border:none;font-family:inherit;font-size:.82rem;\r\n            font-weight:500;cursor:pointer;transition:all .2s;}\r\n        .s-confirm    {background:rgba(41,128,185,.2);color:#2980B9;}\r\n        .s-confirm:hover    {background:rgba(41,128,185,.4);}\r\n        .s-prep       {background:rgba(142,68,173,.2);color:#9B59B6;}\r\n        .s-prep:hover       {background:rgba(142,68,173,.4);}\r\n        .s-ready      {background:rgba(26,188,156,.2);color:#1ABC9C;}\r\n        .s-ready:hover      {background:rgba(26,188,156,.4);}\r\n        .s-delivered  {background:rgba(81,207,102,.15);color:var(--success);}\r\n        .s-delivered:hover  {background:rgba(81,207,102,.3);}\r\n        .s-cancel     {background:rgba(255,107,107,.12);color:var(--error);}\r\n        .s-cancel:hover     {background:rgba(255,107,107,.25);}\r\n\r\n        /* Detail grid */\r\n        .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px;}\r\n        .panel{background:var(--dark2);border-radius:14px;border:1px solid var(--border);\r\n            padding:20px 24px;animation:fadeSlideUp .4s ease both .1s;}\r\n        .panel h4{font-family:'Playfair Display',serif;font-size:.95rem;color:var(--cream);\r\n            margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border);}\r\n        .info-row{display:flex;justify-content:space-between;margin-bottom:8px;font-size:.85rem;}\r\n        .info-label{color:var(--muted);}\r\n        .info-val{color:var(--cream);font-weight:500;text-align:right;}\r\n\r\n        /* Items */\r\n        .items-panel{background:var(--dark2);border-radius:14px;border:1px solid var(--border);\r\n            overflow:hidden;margin-bottom:18px;animation:fadeSlideUp .4s ease both .15s;}\r\n        .items-panel h4{padding:16px 22px;font-family:'Playfair Display',serif;font-size:.95rem;\r\n            color:var(--cream);border-bottom:1px solid var(--border);}\r\n        .item-row{display:flex;align-items:center;gap:14px;padding:13px 22px;\r\n            border-bottom:1px solid rgba(255,255,255,.04);}\r\n        .item-row:last-child{border-bottom:none;}\r\n        .item-thumb{width:44px;height:44px;border-radius:9px;background:#2a1a0a;\r\n            display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;overflow:hidden;}\r\n        .item-thumb img{width:100%;height:100%;object-fit:cover;}\r\n        .item-name{font-weight:500;color:var(--cream);font-size:.9rem;}\r\n        .item-custom{font-size:.75rem;color:var(--accent);margin-top:2px;}\r\n        .item-qty{font-size:.8rem;color:var(--muted);}\r\n        .item-price{margin-left:auto;font-weight:600;color:var(--cream);}\r\n        .total-row{display:flex;justify-content:space-between;padding:14px 22px;background:rgba(196,134,66,.06);}\r\n        .total-label{font-family:'Playfair Display',serif;font-size:.95rem;color:var(--cream);}\r\n        .total-val{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--accent);}\r\n\r\n        /* Admin note */\r\n        .note-panel{background:var(--dark2);border-radius:14px;border:1px solid var(--border);\r\n            padding:20px 24px;animation:fadeSlideUp .4s ease both .2s;}\r\n        .note-panel h4{font-family:'Playfair Display',serif;font-size:.95rem;color:var(--cream);margin-bottom:14px;}\r\n        .existing-note{background:rgba(255,169,77,.07);border:1px solid rgba(255,169,77,.15);\r\n            border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:.875rem;color:var(--warn);}\r\n        textarea.note-input{width:100%;padding:11px 14px;background:#222;border:1px solid var(--border);\r\n            border-radius:10px;color:var(--cream);font-family:inherit;font-size:.875rem;outline:none;\r\n            resize:vertical;min-height:80px;transition:all .2s;}\r\n        textarea.note-input:focus{border-color:rgba(196,134,66,.4);}\r\n        textarea.note-input::placeholder{color:rgba(255,255,255,.2);}\r\n        .btn-save-note{margin-top:10px;padding:9px 22px;background:linear-gradient(135deg,var(--accent2),var(--accent));\r\n            color:#fff;border:none;border-radius:9px;font-family:inherit;font-size:.875rem;cursor:pointer;transition:all .2s;}\r\n        .btn-save-note:hover{transform:translateY(-1px);}\r\n        .btn-back{display:inline-flex;align-items:center;gap:6px;margin-top:16px;\r\n            padding:9px 20px;background:rgba(255,255,255,.06);color:var(--muted);border:1px solid var(--border);\r\n            border-radius:9px;font-family:inherit;font-size:.85rem;text-decoration:none;transition:all .2s;}\r\n        .btn-back:hover{border-color:rgba(196,134,66,.3);color:var(--accent);}\r\n\r\n        @keyframes fadeSlideUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}\r\n        @media(max-width:900px){.sidebar{display:none;}.main{margin-left:0;}}\r\n        @media(max-width:640px){.detail-grid{grid-template-columns:1fr;}.content{padding:16px;}}\r\n    </style>\r\n</head>\r\n<body>\r\n<aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n        <span class=\"logo\">\uD83C\uDF6B</span>\r\n        <h2>Sugar Corner</h2>\r\n        <span class=\"role-badge\">Admin Panel</span>\r\n    </div>\r\n    <nav>\r\n        <div class=\"nav-section\">Overview</div>\r\n        <a class=\"nav-item\" href=\"/admin/dashboard\"><span class=\"nav-icon\">\uD83D\uDCCA</span> Dashboard</a>\r\n        <div class=\"nav-section\">Customer Mgmt</div>\r\n        <a class=\"nav-item\" href=\"/admin/customers\"><span class=\"nav-icon\">\uD83D\uDC65</span> All Customers</a>\r\n        <div class=\"nav-section\">Product Mgmt</div>\r\n        <a class=\"nav-item\" href=\"/admin/products\"><span class=\"nav-icon\">\uD83C\uDF6B</span> All Products</a>\r\n        <a class=\"nav-item\" href=\"/admin/products/add\"><span class=\"nav-icon\">➕</span> Add Product</a>\r\n        <div class=\"nav-section\">Order Mgmt</div>\r\n        <a class=\"nav-item active\" href=\"/admin/orders\"><span class=\"nav-icon\">\uD83D\uDCE6</span> All Orders\r\n            <span class=\"nav-badge\" th:if=\"${pendingCount > 0}\" th:text=\"${pendingCount}\">0</span>\r\n        </a>\r\n        <div class=\"nav-section\">Coming Soon</div>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCB3</span> Payments</a>\r\n        <a class=\"nav-item\" href=\"#\"><span class=\"nav-icon\">\uD83D\uDCAC</span> Inquiries</a>\r\n    </nav>\r\n    <div class=\"sidebar-footer\">\r\n        <a class=\"logout-btn\" href=\"/logout\"><span>\uD83D\uDEAA</span> Sign Out</a>\r\n    </div>\r\n</aside>\r\n\r\n<div class=\"main\">\r\n    <div class=\"topbar\">\r\n        <a href=\"/admin/orders\">Orders</a>\r\n        <span class=\"sep\">›</span>\r\n        <h1 th:text=\"'Order #' + ${order.id}\">Order</h1>\r\n    </div>\r\n    <div class=\"content\">\r\n\r\n        <div th:if=\"${param.success != null}\" class=\"alert alert-success\">\r\n            ✅\r\n            <span th:if=\"${param.success[0] == 'status'}\">Order status updated successfully!</span>\r\n            <span th:if=\"${param.success[0] == 'note'}\">Admin note saved!</span>\r\n        </div>\r\n\r\n        <!-- Header card -->\r\n        <div class=\"order-header-card\">\r\n            <div>\r\n                <div class=\"order-id-big\" th:text=\"'Order #' + ${order.id}\">Order #1</div>\r\n                <div class=\"order-meta\">\r\n                    Placed by <strong th:text=\"${order.customerFullName}\">Customer</strong>\r\n                    on <span th:text=\"${#temporals.format(order.createdAt,'dd MMM yyyy, hh:mm a')}\">date</span>\r\n                </div>\r\n                <div class=\"order-meta\" style=\"margin-top:4px;\"\r\n                     th:text=\"${order.customerEmail + ' · ' + (order.customerPhone != null ? order.customerPhone : 'No phone')}\">\r\n                </div>\r\n            </div>\r\n            <span class=\"chip\"\r\n                  th:text=\"${order.statusLabel}\">Status</span>\r\n        </div>\r\n\r\n        <!-- Status update -->\r\n        <div class=\"status-form\">\r\n            <h4>⚙\uFE0F Update Order Status</h4>\r\n            <div class=\"status-grid\">\r\n                <form method=\"POST\" th:action=\"'/admin/orders/' + ${order.id} + '/status'\">\r\n                    <input type=\"hidden\" name=\"status\" value=\"CONFIRMED\"/>\r\n                    <button type=\"submit\" class=\"status-btn s-confirm\">✅ Confirm</button>\r\n                </form>\r\n                <form method=\"POST\" th:action=\"'/admin/orders/' + ${order.id} + '/status'\">\r\n                    <input type=\"hidden\" name=\"status\" value=\"IN_PREPARATION\"/>\r\n                    <button type=\"submit\" class=\"status-btn s-prep\">\uD83D\uDC69\u200D\uD83C\uDF73 In Preparation</button>\r\n                </form>\r\n                <form method=\"POST\" th:action=\"'/admin/orders/' + ${order.id} + '/status'\">\r\n                    <input type=\"hidden\" name=\"status\" value=\"READY\"/>\r\n                    <button type=\"submit\" class=\"status-btn s-ready\">\uD83D\uDCE6 Ready</button>\r\n                </form>\r\n                <form method=\"POST\" th:action=\"'/admin/orders/' + ${order.id} + '/status'\">\r\n                    <input type=\"hidden\" name=\"status\" value=\"DELIVERED\"/>\r\n                    <button type=\"submit\" class=\"status-btn s-delivered\">\uD83D\uDE9A Delivered</button>\r\n                </form>\r\n                <form method=\"POST\" th:action=\"'/admin/orders/' + ${order.id} + '/status'\"\r\n                      onsubmit=\"return confirm('Cancel this order?')\">\r\n                    <input type=\"hidden\" name=\"status\" value=\"CANCELLED\"/>\r\n                    <button type=\"submit\" class=\"status-btn s-cancel\">❌ Cancel</button>\r\n                </form>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Detail grid -->\r\n        <div class=\"detail-grid\">\r\n            <div class=\"panel\">\r\n                <h4>\uD83D\uDCCD Delivery Info</h4>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Type</span>\r\n                    <span class=\"info-val\" th:text=\"${order.deliveryType == 'PICKUP'} ? '\uD83C\uDFEA Pickup' : '\uD83D\uDE9A Delivery'\">-</span>\r\n                </div>\r\n                <div class=\"info-row\" th:if=\"${order.deliveryAddress != null and order.deliveryAddress != ''}\">\r\n                    <span class=\"info-label\">Address</span>\r\n                    <span class=\"info-val\" th:text=\"${order.deliveryAddress}\">-</span>\r\n                </div>\r\n                <div class=\"info-row\" th:if=\"${order.deliveryCity != null and order.deliveryCity != ''}\">\r\n                    <span class=\"info-label\">City</span>\r\n                    <span class=\"info-val\" th:text=\"${order.deliveryCity}\">-</span>\r\n                </div>\r\n                <div class=\"info-row\" th:if=\"${order.deliveryPostalCode != null and order.deliveryPostalCode != ''}\">\r\n                    <span class=\"info-label\">Postal Code</span>\r\n                    <span class=\"info-val\" th:text=\"${order.deliveryPostalCode}\">-</span>\r\n                </div>\r\n                <div class=\"info-row\" th:if=\"${order.customerNote != null and order.customerNote != ''}\">\r\n                    <span class=\"info-label\">Customer Note</span>\r\n                    <span class=\"info-val\" th:text=\"${order.customerNote}\">-</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"panel\">\r\n                <h4>\uD83D\uDC64 Customer</h4>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Name</span>\r\n                    <span class=\"info-val\" th:text=\"${order.customerFullName}\">-</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Email</span>\r\n                    <span class=\"info-val\" th:text=\"${order.customerEmail}\">-</span>\r\n                </div>\r\n                <div class=\"info-row\" th:if=\"${order.customerPhone != null}\">\r\n                    <span class=\"info-label\">Phone</span>\r\n                    <span class=\"info-val\" th:text=\"${order.customerPhone}\">-</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Total Amount</span>\r\n                    <span class=\"info-val\" style=\"color:var(--accent);\"\r\n                          th:text=\"'Rs. ' + ${#numbers.formatDecimal(order.totalAmount,1,'COMMA',2,'POINT')}\">-</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Items -->\r\n        <div class=\"items-panel\">\r\n            <h4>\uD83C\uDF6B Order Items</h4>\r\n            <div th:each=\"item : ${order.items}\" class=\"item-row\">\r\n                <div class=\"item-thumb\">\r\n                    <img th:if=\"${item.productImage != null}\" th:src=\"'/' + ${item.productImage}\" th:alt=\"${item.productName}\"/>\r\n                    <span th:unless=\"${item.productImage != null}\">\uD83C\uDF6B</span>\r\n                </div>\r\n                <div>\r\n                    <div class=\"item-name\" th:text=\"${item.productName}\">Brownie</div>\r\n                    <div class=\"item-qty\" th:text=\"'Qty: ' + ${item.quantity}\">Qty: 1</div>\r\n                    <div class=\"item-custom\"\r\n                         th:if=\"${item.customization != null and item.customization != ''}\"\r\n                         th:text=\"'Note: ' + ${item.customization}\"></div>\r\n                </div>\r\n                <div class=\"item-price\"\r\n                     th:text=\"'Rs. ' + ${#numbers.formatDecimal(item.subtotal,1,'COMMA',2,'POINT')}\">Rs. 0</div>\r\n            </div>\r\n            <div class=\"total-row\">\r\n                <span class=\"total-label\">Total</span>\r\n                <span class=\"total-val\"\r\n                      th:text=\"'Rs. ' + ${#numbers.formatDecimal(order.totalAmount,1,'COMMA',2,'POINT')}\">Rs. 0</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Admin note -->\r\n        <div class=\"note-panel\">\r\n            <h4>\uD83D\uDCDD Internal Admin Note</h4>\r\n            <div class=\"existing-note\"\r\n                 th:if=\"${order.adminNote != null and order.adminNote != ''}\">\r\n                <strong>Current note:</strong> <span th:text=\"${order.adminNote}\"></span>\r\n            </div>\r\n            <form method=\"POST\" th:action=\"'/admin/orders/' + ${order.id} + '/note'\">\r\n        <textarea class=\"note-input\" name=\"adminNote\"\r\n                  placeholder=\"e.g. Allergic to nuts – double check, Extra packaging needed…\"\r\n                  th:text=\"${order.adminNote != null} ? ${order.adminNote} : ''\"></textarea>\r\n                <button type=\"submit\" class=\"btn-save-note\">\uD83D\uDCBE Save Note</button>\r\n            </form>\r\n        </div>\r\n\r\n        <a href=\"/admin/orders\" class=\"btn-back\">← Back to Orders</a>\r\n    </div>\r\n</div>\r\n</body>\r\n</html>
